    const uiScale = 1;
    ctx.scale(uiScale, uiScale);
    const hudWidth = W / uiScale;

    const compact = W < 700;
    const statsPanelX = 18;
    const statsPanelY = compact ? H - 72 : 18;
    const statsPanelW = compact ? W - 36 : 360;
    const statsPanelH = compact ? 58 : 138;

    drawPanel(statsPanelX, statsPanelY, statsPanelW, statsPanelH);

    if (!compact) {
        ctx.save();
        roundRectPath(statsPanelX + 10, statsPanelY + 10, 96, statsPanelH - 20, 8);
        ctx.fillStyle = "rgba(20,50,60,.95)";
        ctx.fill();
        ctx.strokeStyle = "rgba(140,210,220,.7)";
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.translate(statsPanelX + 58 - 8 * 1.4, statsPanelY + statsPanelH / 2 - 3 * 1.4);
        ctx.scale(1.4, 1.4);
        drawAstronautBody(0, 1.3, 0, 0, true);
        ctx.restore();

        ctx.fillStyle = "#e8fbff";
        ctx.font = "bold 14px Arial";
        ctx.textAlign = "left";
        ctx.fillText("FUNDADOR DE LA COLONIA", 138, 40);
    }

    ctx.textAlign = "left";
    const stats = [
        ["Vidas", lives, "#7dff8f"],
        ["Monedas", Math.floor(credits), "#ffd166"],
        ["Enemigos", enemies.length, "#ff7272"],
        ["Oleada", wave, "#52e6ff"]
    ];

    stats.forEach(([label, value, color], index) => {
        if (compact) {
            const columnX = statsPanelX + statsPanelW * (index + .5) / stats.length;
            ctx.textAlign = "center";
            ctx.fillStyle = "#dce7eb";
            ctx.font = "12px Arial";
            ctx.fillText(label, columnX, statsPanelY + 22);
            ctx.fillStyle = color;
            ctx.font = "bold 16px Arial";
            ctx.fillText(String(value), columnX, statsPanelY + 45);
            ctx.textAlign = "left";
        } else {
            const y = 64 + index * 20;
            ctx.fillStyle = "#dce7eb";
            ctx.font = "bold 16px Arial";
            ctx.fillText(label, 138, y);
            ctx.fillStyle = color;
            ctx.textAlign = "right";
            ctx.fillText(String(value), 346, y);
            ctx.textAlign = "left";
        }
    });

    const buildMenuW = BUILD_MENU_LAYOUT.width;
    const buildMenuH = BUILD_MENU_LAYOUT.height;
    const buildMenuX = hudWidth - buildMenuW - 18;
    const buildMenuY = 18;

    drawPanel(buildMenuX, buildMenuY, buildMenuW, buildMenuH);

    ctx.fillStyle = "#00f3ff";
    ctx.font = "bold 18px Arial";
    ctx.textAlign = "center";
    ctx.fillStyle = "#e8fbff";
    ctx.fillText("CONSTRUIR", buildMenuX + buildMenuW / 2, buildMenuY + 30);
    ctx.textAlign = "left";

    BUILD_MENU_ITEMS.forEach((item, i) => {
        const rowY = buildMenuY + BUILD_MENU_LAYOUT.rowTop + i * (
            BUILD_MENU_LAYOUT.rowHeight + BUILD_MENU_LAYOUT.rowGap
        );
        const selected = selectedBuild === item.id;

        ctx.fillStyle = selected ? "rgba(0,243,255,.2)" : "rgba(255,255,255,.04)";
        ctx.fillRect(buildMenuX + 10, rowY, buildMenuW - 20, BUILD_MENU_LAYOUT.rowHeight);
        ctx.strokeStyle = selected ? "rgba(0,243,255,.9)" : "rgba(255,255,255,.2)";
        ctx.lineWidth = 1;
        ctx.strokeRect(buildMenuX + 10, rowY, buildMenuW - 20, BUILD_MENU_LAYOUT.rowHeight);

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 14px Arial";
        drawBuildIcon(item.id, buildMenuX + 34, rowY + BUILD_MENU_LAYOUT.rowHeight / 2);
        ctx.fillText(`${i + 1}. ${item.name}`, buildMenuX + 58, rowY + 24);

        ctx.fillStyle = "#7cff89";
        ctx.font = "12px Arial";
        ctx.textAlign = "right";
        ctx.fillText(`${BUILD_COST[item.id]}$`, buildMenuX + buildMenuW - 18, rowY + 24);
        ctx.textAlign = "left";
    });

    const shopButtonX = buildMenuX;
    const shopButtonY = buildMenuY + buildMenuH + BUILD_MENU_LAYOUT.shopGap;
    const shopButtonW = buildMenuW;
    const shopButtonH = BUILD_MENU_LAYOUT.shopHeight;

    ctx.fillStyle = shopOpen ? "rgba(0,243,255,.18)" : "rgba(9,18,25,.82)";
    ctx.fillRect(shopButtonX, shopButtonY, shopButtonW, shopButtonH);
    ctx.strokeStyle = "rgba(0,243,255,.8)";
    ctx.lineWidth = 2;
    ctx.strokeRect(shopButtonX, shopButtonY, shopButtonW, shopButtonH);

    ctx.fillStyle = "#00f3ff";
    ctx.font = "bold 15px Arial";
    ctx.textAlign = "center";
    ctx.fillText(shopOpen ? "CERRAR TIENDA" : "ABRIR TIENDA", shopButtonX + shopButtonW / 2, shopButtonY + 27);

    ctx.restore();
}

/* =========================================================
