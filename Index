function handleRecruitmentClick(x, y) {
    if (!recruitmentOpen) return false;

    const panel = recruitmentPanelBounds();
    const inside = x >= panel.x && x <= panel.x + panel.width &&
        y >= panel.y && y <= panel.y + panel.height;

    if (!inside) {
        recruitmentOpen = false;
        return true;
    }

    if (y <= panel.y + 38 && x >= panel.x + panel.width - 44) {
        recruitmentOpen = false;
        return true;
    }

    ALLY_RECRUITS.forEach((recruit, index) => {
        const rowY = panel.y + 42 + index * 57;
        if (y >= rowY && y <= rowY + 49) {
            recruitAlly(recruit.id);
        }
    });

    return true;
}

