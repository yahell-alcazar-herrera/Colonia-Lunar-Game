function resetGame() {
    resetNotifications();

    credits = 0;
    lives = 3;
    wave = 0;

    waveTimer = 0;
    spawnTimer = 0;

    waveInProgress = false;

    currentWaveEnemies = 0;
    spawnedThisWave = 0;

    selectedBuild = null;
    selectedWeapon = "blaster";
    shopOpen = false;
    recruitmentOpen = false;
    gameOver = false;
    screenShake = 0;

    SHOP_WEAPONS.forEach(weapon => {
        weapon.unlocked = weapon.price === 0;
    });

    player =
        createPlayer();

    colony =
        createColony();

    enemies = [];
    bullets = [];
    structures = [];
    particles = [];
    coins = [];
    allies = [];

    camera.x =
        WORLD_W / 2;

    camera.y =
        WORLD_H / 2;

    document.getElementById(
        "gameOver"
    ).style.display = "none";
}

document.getElementById(
