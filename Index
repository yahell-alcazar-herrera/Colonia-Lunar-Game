/* ---------- Bucle móvil ---------- */

function touchUpdate(dt) {
    if (!player) return;

    const z = getCameraZoom();

    const ps = isoToScreen(player.x, player.y);

    if (selectedBuild) {
        if (settings.touch && !touch.hadBuild) { mouse.x = W / 2; mouse.y = H / 2 + 90; }
        if (settings.touch) {
            mouse.inside = true;
            const q = screenToIso((mouse.x - W / 2) / z + W / 2, (mouse.y - H / 2) / z + H / 2);
            mouse.worldX = q.x;
            mouse.worldY = q.y;
        }
    } else if (settings.touch) {
        if (touch.aiming) {
            let t = screenToIso(ps.x + touch.ax * 220, ps.y + touch.ay * 220);
            mouse.x = ps.x + touch.ax * 220;
            mouse.y = ps.y + touch.ay * 220;

            if (settings.autoaim) {
                const en = findNearestEnemy(player.x, player.y, 650).enemy;
                if (en) {
                    t = { x: en.x, y: en.y };
                    const es = isoToScreen(en.x, en.y);
                    mouse.x = es.x;
                    mouse.y = es.y;
                }
            }

            mouse.inside = true;
            mouse.worldX = t.x;
            mouse.worldY = t.y;
            if (!shopOpen) shootPlayer(t.x, t.y);
        } else if (touch.msx || touch.msy) {
            mouse.x = ps.x + touch.msx * 220;
            mouse.y = ps.y + touch.msy * 220;
            mouse.inside = true;
        }
    }
    touch.hadBuild = !!selectedBuild;

    const cap = [150, 450, 1500][settings.particles];
    if (particles.length > cap) particles.splice(0, particles.length - cap);
}

function syncTouchUI() {
    const t = settings.touch;
    document.getElementById("btnPlace").style.display = t && selectedBuild ? "" : "none";
    document.getElementById("btnCancel").style.display = t && (selectedBuild || shopOpen || recruitmentOpen) ? "" : "none";
}

/* El audio en móvil solo arranca dentro de un toque del usuario */
document.addEventListener("pointerdown", () => {
    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        audioContext = audioContext || new AC();
        if (audioContext.state === "suspended") audioContext.resume();
    } catch { }
}, { passive: true });

window.addEventListener("orientationchange", () => setTimeout(resize, 200));
document.addEventListener("contextmenu", e => e.preventDefault());

applyUI(false);

