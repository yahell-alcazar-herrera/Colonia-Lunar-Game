========================================================= */

function triggerGameOver(reason) {

    if (gameOver)
        return;

    gameOver = true;
    playSound("gameOver");

    document.getElementById(
        "gameOverText"
    ).textContent = tr(reason);

    document.getElementById(
        "gameOver"
    ).style.display = "flex";
}

function checkGameOver() {

    if (colony.hp <= 0) {

        colony.hp = 0;

        triggerGameOver(
            "La cúpula de la colonia fue destruida."
        );

        return;
    }

    if (player.hp <= 0) {

        player.hp = 0;

        lives--;

        if (lives <= 0) {

            triggerGameOver(
                "El último defensor de la colonia ha caído."
            );

        } else {

            player.hp =
                player.maxHp;

            player.x = 510;
            player.y = 470;
        }
    }
}

