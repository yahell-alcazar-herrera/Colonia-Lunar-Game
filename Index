        ctx.fillStyle = "#343b4d";
        ctx.fillRect(-30, -10, 16, 5);

        ctx.fillStyle = "#343b4d";
        ctx.fillRect(-16, -2, 32, 31);
        ctx.fillStyle = "#596477";
        ctx.fillRect(-17, -29, 34, 28);
        ctx.strokeStyle = "#10191e";
        ctx.lineWidth = 3;
        ctx.strokeRect(-17, -29, 34, 28);

        ctx.fillStyle = "#f3fbfc";
        ctx.beginPath();
