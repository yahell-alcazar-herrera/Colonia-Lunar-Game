function getPointerWorldPosition(event) {
    const rect = canvas.getBoundingClientRect();
    const sx = (event.clientX - rect.left) / VS;
    const sy = (event.clientY - rect.top) / VS;
    const zoom = getCameraZoom();
    const world = screenToIso(
        (sx - W / 2) / zoom + W / 2,
        (sy - H / 2) / zoom + H / 2
    );

    return {
        x: sx,
        y: sy,
        worldX: world.x,
        worldY: world.y
    };
}

window.addEventListener(
    "keydown",
    e => {
        const key = (e.key || "").toLowerCase();
        keys[key] = true;

        if (e.key === "b" || e.key === "B") {
            toggleShop();
            return;
        }

        if (BUILD_KEYS[e.key]) {
            if (shopOpen) {
                shopOpen = false;
            }

            const buildId = BUILD_KEYS[e.key];
            selectedBuild = selectedBuild === buildId ? null : buildId;
            return;
        }

        if (e.key === "Escape") {
            selectedBuild = null;
            shopOpen = false;
        }

        if (e.code === "Space" && selectedBuild) {
            e.preventDefault();
            placeStructure(selectedBuild);
        }
    }
);

window.addEventListener(
    "keyup",
    e => {
        keys[(e.key || "").toLowerCase()] = false;
    }
);

canvas.addEventListener(
    "pointermove",
    e => {
        const p = getPointerWorldPosition(e);
        mouse.x = p.x;
        mouse.y = p.y;
        mouse.worldX = p.worldX;
        mouse.worldY = p.worldY;
        mouse.inside = true;
    }
);

canvas.addEventListener(
    "pointerleave",
    e => {
        if (e.pointerType !== "touch") mouse.inside = false;
    }
);

canvas.addEventListener(
    "pointerdown",
    e => {
        if (gameOver)
            return;

        const p = getPointerWorldPosition(e);
        mouse.x = p.x;
        mouse.y = p.y;
        mouse.worldX = p.worldX;
        mouse.worldY = p.worldY;
        mouse.inside = true;

        const uiX = p.x * VS / US;
        const uiY = p.y * VS / US;
        const buildMenuW = BUILD_MENU_LAYOUT.width;
        const buildMenuH = BUILD_MENU_LAYOUT.height;
        const buildMenuX = UW - buildMenuW - 18;
        const buildMenuY = 18;
        const shopButtonX = buildMenuX;
        const shopButtonY = buildMenuY + buildMenuH + BUILD_MENU_LAYOUT.shopGap;
        const shopButtonW = buildMenuW;
        const shopButtonH = BUILD_MENU_LAYOUT.shopHeight;

        if (e.button === 0 &&
            uiX >= shopButtonX &&
            uiX <= shopButtonX + shopButtonW &&
            uiY >= shopButtonY &&
            uiY <= shopButtonY + shopButtonH) {
            toggleShop();
            return;
        }

        if (shopOpen) {
            if (withUI(() => handleShopClick(uiX, uiY))) {
                return;
            }
        }

        if (recruitmentOpen && withUI(() => handleRecruitmentClick(uiX, uiY))) {
            return;
        }

        if (e.button === 0 && isRecruitmentStationAt(p.x, p.y)) {
            recruitmentOpen = !recruitmentOpen;
            if (recruitmentOpen) {
                selectedBuild = null;
                shopOpen = false;
            }
            return;
        }

        if (
            e.button === 0 &&
            uiX >= buildMenuX &&
            uiX <= buildMenuX + buildMenuW &&
            uiY >= buildMenuY &&
            uiY <= buildMenuY + buildMenuH
        ) {
            const rowStep = BUILD_MENU_LAYOUT.rowHeight + BUILD_MENU_LAYOUT.rowGap;
            const rowIndex = Math.floor(
                (uiY - buildMenuY - BUILD_MENU_LAYOUT.rowTop) / rowStep
            );
            const item = BUILD_MENU_ITEMS[rowIndex];
            const rowY = buildMenuY + BUILD_MENU_LAYOUT.rowTop + rowIndex * rowStep;

            if (
                item &&
                uiY >= rowY &&
                uiY <= rowY + BUILD_MENU_LAYOUT.rowHeight
            ) {
                selectedBuild = selectedBuild === item.id ? null : item.id;
                return;
            }

            return;
        }

        if (e.button === 0) {
            if (selectedBuild) {
                if (e.pointerType !== "touch") placeStructure(selectedBuild);
            } else if (!shopOpen && e.pointerType !== "touch") {
                shootPlayer(p.worldX, p.worldY);
            }
        }

        if (e.button === 2) {
            e.preventDefault();

            if (selectedBuild) {
                placeStructure(selectedBuild);
            }
        }
    }
);

canvas.addEventListener(
    "contextmenu",
    e => {
        e.preventDefault();
    }
);

