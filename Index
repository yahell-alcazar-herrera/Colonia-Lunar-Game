function handleShopClick(x, y) {
    if (!shopOpen) return false;

    const panelW = 420;
    const panelH = 360;
    const panelX = W / 2 - panelW / 2;
    const panelY = H / 2 - panelH / 2;

    const closeX = panelX + panelW - 90;
    const closeY = panelY + 18;

    if (x >= closeX && x <= closeX + 70 && y >= closeY && y <= closeY + 28) {
        shopOpen = false;
        return true;
    }

    let yy = panelY + 70;
    for (const weapon of SHOP_WEAPONS) {
        const itemX = panelX + 20;
        const itemY = yy;
        const itemW = panelW - 40;
        const itemH = 64;

        if (x >= itemX && x <= itemX + itemW && y >= itemY && y <= itemY + itemH) {
            buyOrSelectWeapon(weapon.id);
            return true;
        }

        yy += 76;
    }

    return true;
}

function recruitAlly(id) {
    const recruit = ALLY_RECRUITS.find(item => item.id === id);

    if (!recruit || credits < recruit.price) return false;

    credits -= recruit.price;
    const guardCount = allies.filter(ally => ally.type === "guard").length;

    allies.push({
        type: recruit.id,
        x: RECRUITMENT_STATION.x + rand(-22, 22),
        y: RECRUITMENT_STATION.y + rand(-18, 18),
        hp: recruit.id === "commander" ? 320 : recruit.id === "drone" ? 90 : 140,
        maxHp: recruit.id === "commander" ? 320 : recruit.id === "drone" ? 90 : 140,
        speed: recruit.id === "commander" ? 48 : recruit.id === "drone" ? 175 : 105,
        radius: recruit.id === "commander" ? 22 : recruit.id === "drone" ? 12 : 10,
        damage: recruit.id === "commander" ? 160 : 28,
        fireCooldown: rand(.15, .55),
        repairClock: 0,
        patrolAngle: guardCount * 2.2,
        patrolRadius: 130 + guardCount % 3 * 45,
        animTime: 0,
        moving: false
    });

    playSound("build");
    createExplosion(
        RECRUITMENT_STATION.x,
        RECRUITMENT_STATION.y,
        recruit.id === "drone" ? "#66eaff" : "#8cecff",
        .8
    );
    return true;
}

/* Posición de la estación: en píxeles del mundo (toques) o de los menús (panel) */
function stationUIPos(worldUnits) {
    const sw = W, sh = H;
    W = WW;
    H = WH;
    const q = isoToScreen(RECRUITMENT_STATION.x, RECRUITMENT_STATION.y);
    W = sw;
    H = sh;
    return worldUnits ? { x: q.x, y: q.y } : { x: q.x * VS / US, y: q.y * VS / US };
}

function recruitmentPanelBounds() {
    const width = Math.min(340, W - 24);
    const height = 226;
    const compact = W < 700;
    const station = stationUIPos();
    const panelY = compact
        ? clamp(station.y + 28, 12, H - height - 72)
        : clamp(station.y - height - 24, 12, H - height - 12);

    return {
        x: clamp(station.x - width / 2, 12, W - width - 12),
        y: panelY,
        width,
        height
    };
}

function isRecruitmentStationAt(x, y) {
    const station = stationUIPos(true);
    const k = Math.max(1, 0.6 / VS);

    return x >= station.x - 58 * k && x <= station.x + 58 * k &&
        y >= station.y - 88 * k && y <= station.y + 20 * k;
}

function drawRecruitmentMenu() {
    if (!recruitmentOpen) return;

    const panel = recruitmentPanelBounds();
