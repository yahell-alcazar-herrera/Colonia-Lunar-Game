function gunBox(x, y, w, h, fill, r) {
    ctx.beginPath();
    ctx.roundRect(x, y, w, h, r === undefined ? 2 : r);
    ctx.fillStyle = fill;
    ctx.fill();
    ctx.stroke();
}

function drawMuzzleFlash(id, mx, color, f) {
    ctx.save();
    ctx.translate(mx, 0);
    ctx.globalAlpha = Math.min(1, f * 1.4);
    ctx.shadowColor = color;
    ctx.shadowBlur = 16;

    if (id === "rail") {
        const len = 12 + 26 * f;
        ctx.lineCap = "round";
        ctx.strokeStyle = color;
        ctx.lineWidth = 7;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(len, 0);
        ctx.stroke();
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(len * .8, 0);
        ctx.stroke();
    } else if (id === "plasma") {
        const r = 7 + 8 * f;
        const g = ctx.createRadialGradient(0, 0, 1, 0, 0, r);
        g.addColorStop(0, "#ffffff");
        g.addColorStop(.5, color);
        g.addColorStop(1, "rgba(185,132,255,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(0, 0, r, 0, Math.PI * 2);
        ctx.fill();
    } else if (id === "scatter") {
        ctx.fillStyle = color;
        for (const ang of [-.38, 0, .38]) {
            ctx.save();
            ctx.rotate(ang);
            ctx.beginPath();
            ctx.moveTo(0, -3);
            ctx.lineTo(10 + 10 * f, 0);
            ctx.lineTo(0, 3);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(2, 0, 4, 0, Math.PI * 2);
        ctx.fill();
    } else {
        const r = 6 + 6 * f;
        ctx.fillStyle = color;
        ctx.beginPath();
        for (let i = 0; i < 8; i++) {
            const rr = i % 2 === 0 ? r : r * .35;
            const a = i * Math.PI / 4;
            if (i === 0) ctx.moveTo(Math.cos(a) * rr, Math.sin(a) * rr);
            else ctx.lineTo(Math.cos(a) * rr, Math.sin(a) * rr);
        }
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(0, 0, 2.6, 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.restore();
}

/* Dibuja el arma apuntando a +X, con el agarre en (0,0) */
function drawWeaponSprite(id, flash) {
    const color = getWeaponById(id).color;
    let muzzle = 29;

    ctx.save();
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = "#0a1526";
    ctx.lineJoin = "round";

    if (id === "scatter") {
        muzzle = 38;
        gunBox(-14, -4, 14, 10, "#8a5a2b", 2);
        gunBox(-2, -7, 15, 11, "#4a505c", 2);
        gunBox(13, -7, 22, 5, "#9aa5b3", 1.5);
        gunBox(13, -2, 22, 5, "#727d8b", 1.5);
        gunBox(15, 4, 13, 5, "#8a5a2b", 2);
        gunBox(33, -8, 4, 15, color, 1.5);
    } else if (id === "rail") {
        muzzle = 48;
        gunBox(-3, 5, 6, 9, "#2a2f3d", 2);
        gunBox(-9, -5, 21, 11, "#2a2f3d", 3);
        gunBox(0, -10, 11, 4, "#8fb8ff", 1.5);
        gunBox(12, -3.5, 32, 7, "#3b4254", 2);
        ctx.strokeStyle = "#cfd6e3";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(13, -2);
        ctx.lineTo(43, -2);
        ctx.moveTo(13, 2);
        ctx.lineTo(43, 2);
        ctx.stroke();
        ctx.strokeStyle = "#0a1526";
        ctx.lineWidth = 2;
        ctx.shadowColor = color;
        ctx.shadowBlur = 8;
        for (const x of [16, 24, 32]) gunBox(x, -6.5, 3.5, 13, color, 1);
        ctx.shadowBlur = 0;
        ctx.lineWidth = 2.5;
        gunBox(42, -4.5, 4, 9, "#1a1d28", 1);
    } else if (id === "plasma") {
        muzzle = 35;
        gunBox(-3, 6, 7, 11, "#2c2044", 2);
        gunBox(-9, -9, 28, 17, "#5a3a8c", 6);
        gunBox(2, -13, 9, 4, "#3f2a66", 1.5);
        ctx.beginPath();
        ctx.moveTo(19, -6);
        ctx.lineTo(32, -10);
        ctx.lineTo(32, 10);
        ctx.lineTo(19, 7);
        ctx.closePath();
        ctx.fillStyle = "#3f2a66";
        ctx.fill();
        ctx.stroke();
        const orb = ctx.createRadialGradient(4, -2, 1, 6, 0, 7);
        orb.addColorStop(0, "#f6ecff");
        orb.addColorStop(1, color);
        ctx.shadowColor = color;
        ctx.shadowBlur = 12;
        ctx.fillStyle = orb;
        ctx.beginPath();
        ctx.arc(6, -0.5, 6.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = "#e9d6ff";
        ctx.beginPath();
        ctx.arc(32, 0, 3, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
    } else {
        muzzle = 29;
        gunBox(-4, 1, 7, 11, "#2f3a4a", 2);
        gunBox(-7, -6, 26, 10, "#7d8da3", 3);
        ctx.fillStyle = "#c1cee0";
        ctx.fillRect(-3, -5, 16, 2.5);
        gunBox(19, -4, 7, 6, "#2f3a4a", 2);
        ctx.shadowColor = color;
        ctx.shadowBlur = 8;
        ctx.fillStyle = color;
        ctx.fillRect(0, -2, 13, 2);
        ctx.beginPath();
        ctx.arc(27, -1, 2.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
    }

    ctx.restore();

    if (flash > 0) {
        drawMuzzleFlash(id, muzzle, color, Math.min(1, flash / .09));
    }
}

function drawAstronautBody(walk, angle = 0, recoil = 0, flash = 0, hideWeapon = false) {
    const line = "#0a1526";
    ctx.lineWidth = 3;
    ctx.strokeStyle = line;

    /* Piernas */
    for (const [lx, dir] of [[-7, 1], [7, -1]]) {
        ctx.save();
        ctx.translate(lx, 25);
        ctx.rotate(walk * .34 * dir);
        ctx.fillStyle = "#2456a8";
        ctx.fillRect(-4.5, 0, 9, 11);
        ctx.strokeRect(-4.5, 0, 9, 11);
        ctx.fillStyle = "#1a2a48";
        ctx.fillRect(-5.5, 10, 11, 5);
        ctx.strokeRect(-5.5, 10, 11, 5);
        ctx.restore();
    }

    /* Mochila */
    ctx.fillStyle = "#c9a06a";
    ctx.fillRect(-19, 0, 8, 20);
    ctx.strokeRect(-19, 0, 8, 20);

    /* Torso */
    ctx.fillStyle = "#2f7fdc";
    ctx.fillRect(-12, -3, 24, 30);
    ctx.strokeRect(-12, -3, 24, 30);
    ctx.fillStyle = "#1d4f9c";
    ctx.fillRect(-12, 18, 24, 4);
    ctx.fillStyle = "#9fd0ff";
    ctx.fillRect(-5, 4, 10, 5);

    /* Brazo + arma */
    const sx = 8;
    const sy = 5;
    const a = angle - recoil * .22;
    const reach = 9 - recoil * 3;
    const hx = sx + Math.cos(a) * reach;
    const hy = sy + Math.sin(a) * reach;

    ctx.lineCap = "round";
    ctx.strokeStyle = line;
    ctx.lineWidth = 9;
    ctx.beginPath();
    ctx.moveTo(sx, sy);
    ctx.lineTo(hx, hy);
    ctx.stroke();
    ctx.strokeStyle = "#2f7fdc";
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.moveTo(sx, sy);
    ctx.lineTo(hx, hy);
    ctx.stroke();
    ctx.lineCap = "butt";

    if (!hideWeapon) {
        ctx.save();
        ctx.translate(hx, hy);
        ctx.rotate(a);
        ctx.translate(-recoil * 4, 0);
        drawWeaponSprite(selectedWeapon, flash);
        ctx.restore();
    }

    ctx.fillStyle = "#e8b98a";
    ctx.strokeStyle = line;
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.arc(hx, hy, 3.6, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    /* Casco */
    ctx.lineWidth = 3;
    ctx.fillStyle = "#3d8be8";
    ctx.beginPath();
    ctx.arc(0, -16, 17, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.fillStyle = "rgba(255,255,255,.4)";
    ctx.beginPath();
    ctx.ellipse(-6, -28, 7, 3, -.3, 0, Math.PI * 2);
    ctx.fill();

    /* Cara */
    ctx.fillStyle = "#f2cba6";
    ctx.beginPath();
    ctx.roundRect(-10, -23, 20, 14, 4);
    ctx.fill();
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.fillStyle = "#1a1a2e";
    ctx.fillRect(-5, -18, 3, 4);
    ctx.fillRect(3, -18, 3, 4);
}

function drawPlayer() {

    const p = isoToScreen(
        player.x,
        player.y
    );
    const walkPhase = player.moving
        ? Math.sin(player.animTime * 14)
        : 0;
    const bob = player.moving
        ? Math.abs(walkPhase) * 2
        : Math.sin(player.animTime * 2) * .8;

    /* Direccion de apuntado hacia el cursor */
    const chestY = p.y - 8 - bob;
    let aimX = player.aimDX === undefined ? 1 : player.aimDX;
    let aimY = player.aimDY === undefined ? 0 : player.aimDY;
    if (mouse.inside) {
        aimX = mouse.x - p.x;
        aimY = mouse.y - chestY;
        player.aimDX = aimX;
        player.aimDY = aimY;
    }
    const facing = aimX >= 0 ? 1 : -1;
    const aimAngle = Math.atan2(aimY, Math.abs(aimX) || 0.001);
    const recoil = clamp(player.recoil || 0, 0, 1);

    ctx.save();

    ctx.translate(p.x, p.y - bob);

    ctx.fillStyle = "rgba(0,0,0,.35)";
    ctx.beginPath();
    ctx.ellipse(0, 17, 23, 9, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.save();
    ctx.scale(facing, 1);
    ctx.translate(-recoil * 2, 0);
    drawAstronautBody(walkPhase, aimAngle, recoil, player.flash || 0);
    ctx.restore();

    ctx.restore();

    drawHealthBar(
        p.x,
        p.y - 58,
        60,
        player.hp,
        player.maxHp,
        "#4cff75"
    );
}

/* =========================================================
   CONSTRUCCIONES
========================================================= */

function canPlace(x, y, type) {

    if (
        Math.hypot(
            x - MOON_CENTER.x,
            y - MOON_CENTER.y
        ) > MOON_RADIUS - 80
    ) {
        return false;
    }

    if (dist({x, y}, colony) < 145)
        return false;

    if (dist({x, y}, player) < 60)
        return false;

    for (const s of structures) {

        if (
            dist({x, y}, s) < 65
        ) {
            return false;
        }
    }

    return credits >= BUILD_COST[type];
}

function placeStructure(type) {

    const x = mouse.worldX;
    const y = mouse.worldY;

    if (!canPlace(x, y, type))
        return;

    credits -= BUILD_COST[type];

    structures.push({
        type,
        x,
        y,

        hp:
            type === "wall"
                ? 500
                : 300,

        maxHp:
            type === "wall"
                ? 500
                : 300,

        cooldown: rand(0, 1),
        incomeTimer: 0
    });

    playSound("build");
    createExplosion(
        x,
        y,
        type === "drill" ? "#6aff6a" : type === "shield" ? "#ffb347" : "#8cecff",
        .55
    );
}

function drawStructure(s) {
    const p = isoToScreen(s.x, s.y);
    const line = "#161219";

    if (s.type === "wall") {
        isoBox(
            s.x, s.y, 30,
            60, 25, 55,
            "#c6cbde",
            "#7d84a4",
            "#9ba2bf"
        );
    }

    if (s.type === "turret") {
        polygon([
            { x: p.x, y: p.y - 4 },
            { x: p.x + 44, y: p.y + 14 },
            { x: p.x, y: p.y + 32 },
            { x: p.x - 44, y: p.y + 14 }
        ], "#8a6c12", line, 3);

        polygon([
            { x: p.x, y: p.y - 56 },
            { x: p.x - 32, y: p.y + 8 },
            { x: p.x, y: p.y + 24 }
        ], "#f5c826", line, 3);
        polygon([
            { x: p.x, y: p.y - 56 },
            { x: p.x, y: p.y + 24 },
            { x: p.x + 32, y: p.y + 8 }
        ], "#c99a0e", line, 3);

        ctx.lineCap = "round";
        ctx.strokeStyle = line;
        ctx.lineWidth = 12;
        ctx.beginPath();
        ctx.moveTo(p.x + 4, p.y - 26);
        ctx.lineTo(p.x + 36, p.y - 40);
        ctx.stroke();
        ctx.strokeStyle = "#7b8494";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(p.x + 4, p.y - 26);
        ctx.lineTo(p.x + 34, p.y - 39);
        ctx.stroke();
        ctx.lineCap = "butt";
    }

    if (s.type === "shield") {
        ctx.fillStyle = "#3d4658";
        ctx.strokeStyle = line;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.ellipse(p.x, p.y + 4, 20, 8, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        const g = ctx.createLinearGradient(p.x - 90, p.y - 100, p.x + 60, p.y);
        g.addColorStop(0, "rgba(255,190,90,.55)");
        g.addColorStop(1, "rgba(255,110,20,.28)");
        ctx.fillStyle = g;
        ctx.strokeStyle = "rgba(255,150,40,.95)";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.ellipse(p.x, p.y, 110, 45, 0, 0, Math.PI);
        ctx.ellipse(p.x, p.y, 110, 45, 0, Math.PI, Math.PI * 2, false);
        ctx.fill();
        ctx.stroke();

        ctx.beginPath();
        ctx.ellipse(p.x, p.y, 110, 72, 0, Math.PI, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.4)";
        ctx.beginPath();
        ctx.ellipse(p.x - 44, p.y - 46, 22, 9, -.6, 0, Math.PI * 2);
        ctx.fill();
    }

    if (s.type === "drill") {
        isoBox(
            s.x, s.y, 35,
            45, 45, 50,
            "#8dff86",
            "#2f9a3d",
            "#4fcf5a"
        );

        polygon([
            { x: p.x - 27, y: p.y - 2 },
            { x: p.x - 10, y: p.y + 7 },
            { x: p.x - 10, y: p.y + 21 },
            { x: p.x - 27, y: p.y + 12 }
        ], "#123d1e", line, 2);
        polygon([
            { x: p.x - 23, y: p.y + 2 },
            { x: p.x - 14, y: p.y + 6 },
            { x: p.x - 14, y: p.y + 12 },
            { x: p.x - 23, y: p.y + 8 }
        ], "#43ff6b", null);

        polygon([
            { x: p.x + 26, y: p.y - 2 },
            { x: p.x + 60, y: p.y + 9 },
            { x: p.x + 26, y: p.y + 22 }
        ], "#cdd5d8", line, 3);
        ctx.strokeStyle = "#7a858a";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(p.x + 34, p.y + 1);
        ctx.lineTo(p.x + 34, p.y + 18);
        ctx.moveTo(p.x + 43, p.y + 4);
        ctx.lineTo(p.x + 43, p.y + 15);
        ctx.moveTo(p.x + 52, p.y + 7);
        ctx.lineTo(p.x + 52, p.y + 12);
        ctx.stroke();
    }

    drawHealthBar(
        p.x,
        p.y - 78,
        60,
        s.hp,
        s.maxHp,
        "#64ff7b"
    );
}

/* =========================================================
   PREVIEW
========================================================= */

function drawBuildPreview() {

    if (!selectedBuild || !mouse.inside)
        return;

    const x = mouse.worldX;
    const y = mouse.worldY;

    const valid =
        canPlace(
            x,
            y,
            selectedBuild
        );

    const p = isoToScreen(x, y);

    ctx.save();
    ctx.globalAlpha = .55;

    if (selectedBuild === "wall") {

        isoBox(
            x, y, 30,
            60, 25, 55,
            valid ? "#c9cdd0" : "#ff4444",
            valid ? "#777" : "#991111",
            valid ? "#999" : "#bb2222"
        );
    }

    if (selectedBuild === "turret") {

        polygon([
            {x:p.x, y:p.y-55},
            {x:p.x+35, y:p.y},
            {x:p.x, y:p.y+12},
            {x:p.x-35, y:p.y}
        ],
        valid ? "#ffe76a" : "#ff4444");
    }

    if (selectedBuild === "shield") {

        ctx.strokeStyle =
            valid ? "#ffb52e" : "#ff3333";

        ctx.lineWidth = 4;

        ctx.beginPath();

        ctx.ellipse(
            p.x,
            p.y,
            110,
            45,
            0,
            0,
            Math.PI * 2
        );

        ctx.stroke();
    }

    if (selectedBuild === "drill") {

        isoBox(
            x, y, 35,
            45, 45, 50,
            valid ? "#76ff80" : "#ff4444",
            valid ? "#248c3b" : "#991111",
            valid ? "#45c853" : "#bb2222"
        );
    }

    ctx.restore();
}

/* =========================================================
   ENEMIGOS
========================================================= */

function spawnEnemy() {

    const roll = Math.random();

    let type;

    const variantRoll = Math.random();
    const variants = ["bat"];
    if (wave >= 3) variants.push("slime");
    if (wave >= 4) variants.push("beetle");

    if (wave % 5 === 0)
        type = "boss";
    else if (wave >= 2 && variantRoll < Math.min(.55, .25 + wave * .03))
        type = variants[Math.floor(Math.random() * variants.length)];
    else if (roll < Math.max(.15, .45 - wave * .02))
        type = "red";
    else if (roll < Math.max(.15, .45 - wave * .02) + .37)
        type = "green";
    else
        type = "purple";

    const difficulty =
        1 + wave * .12;
    const damageScale =
        1 + wave * .06;
    const speedScale =
        1 + wave * .01;

    const y =
        rand(
            MOON_CENTER.y - 500,
            MOON_CENTER.y + 500
        );

    let e;

    if (type === "red") {

        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: 55 * difficulty,
            maxHp: 55 * difficulty,

            speed: (135 + wave * 3) * speedScale,

            damage: Math.round(20 * damageScale),
            radius: 20,
            reward: 35,

            attackCooldown: 0
        };
    }

    if (type === "green") {

        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: 100 * difficulty,
            maxHp: 100 * difficulty,

            speed: (75 + wave * 2) * speedScale,

            damage: Math.round(28 * damageScale),
            radius: 24,
            reward: 50,

            attackCooldown: 0
        };
    }

    if (type === "purple") {

        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: 330 * difficulty,
            maxHp: 330 * difficulty,

            speed: (35 + wave) * speedScale,

            damage: Math.round(55 * damageScale),
            radius: 35,
            reward: 120,

            attackCooldown: 0
        };
    }

    if (type === "bat") {

        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: 32 * difficulty,
            maxHp: 32 * difficulty,

            speed: (190 + wave * 3) * speedScale,

            damage: Math.round(14 * damageScale),
            radius: 16,
            reward: 30,
            wobble: rand(0, Math.PI * 2),

            attackCooldown: 0
        };
    }

    if (type === "beetle") {

        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: 260 * difficulty,
            maxHp: 260 * difficulty,

            speed: (48 + wave * 1.5) * speedScale,

            damage: Math.round(40 * damageScale),
            radius: 34,
            reward: 95,
            armor: .6,

            attackCooldown: 0
        };
    }

    if (type === "slime") {

        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: 90 * difficulty,
            maxHp: 90 * difficulty,

            speed: (70 + wave * 2) * speedScale,

            damage: Math.round(22 * damageScale),
            radius: 24,
            reward: 45,

            attackCooldown: 0
        };
    }

    if (type === "boss") {
        const bossHealth = 4200 + wave * 450;
        e = {
            type,
            x: MOON_CENTER.x + MOON_RADIUS - 50,
            y,

            hp: bossHealth,
            maxHp: bossHealth,

            speed: 42 + wave * 1.5,

            damage: 95 + wave * 5,
            radius: 86,
            reward: 650 + wave * 75,

            attackCooldown: 0
        };
    }

    enemies.push(e);
}

function spawnMiniSlimes(x, y) {
    const difficulty = 1 + wave * .12;
    const damageScale = 1 + wave * .06;

    for (let i = 0; i < 2; i++) {
        enemies.push({
            type: "minislime",
            x: x + (i === 0 ? -18 : 18),
            y: y + rand(-14, 14),

            hp: 30 * difficulty,
            maxHp: 30 * difficulty,

            speed: 110 + wave * 2,

            damage: Math.round(12 * damageScale),
            radius: 14,
            reward: 12,

            attackCooldown: 0
        });
    }
}

const ENEMY_DEATH_COLORS = {
    boss: "#ff3c78",
    purple: "#c45cff",
    green: "#57ff63",
    red: "#ff4a4a",
    bat: "#7a5cff",
    beetle: "#ffb02e",
    slime: "#f2e13a",
    minislime: "#f2e13a"
};

const ENEMY_BAR_COLORS = {
    boss: "#ff4f7d",
    purple: "#d15cff",
    bat: "#8a6cff",
    beetle: "#ffb02e",
    slime: "#f2e13a",
    minislime: "#f2e13a"
};

function drawEnemy(e) {

    const p = isoToScreen(
        e.x,
        e.y
    );

    const phase = performance.now() * .004 + (e.x + e.y) * .01;
    const bob = Math.sin(phase * 1.5) * 2.5;

    ctx.save();
    ctx.translate(p.x, p.y + bob);

    if (e.type === "red") {
        ctx.rotate(Math.sin(phase) * .06);
    } else if (e.type === "green") {
        const pulse = Math.sin(phase * 1.7) * .035;
        ctx.scale(1 + pulse, 1 - pulse);
    } else if (e.type === "purple") {
        ctx.rotate(Math.sin(phase * .45) * .035);
    }

    ctx.fillStyle = "rgba(0,0,0,.3)";
    ctx.beginPath();
    ctx.ellipse(
        0,
        18,
        e.radius,
        e.radius * .35,
        0,
        0,
        Math.PI * 2
    );
    ctx.fill();

    if (e.type === "red") {
        ctx.translate(0, -8);
        ctx.lineJoin = "round";
        ctx.lineWidth = 4;
        ctx.strokeStyle = "#1a0508";

        ctx.fillStyle = "#ff4d4d";
        ctx.beginPath();
        ctx.moveTo(-28, 2);
        ctx.lineTo(18, -24);
        ctx.lineTo(18, 4);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#b81a2c";
        ctx.beginPath();
        ctx.moveTo(-28, 2);
        ctx.lineTo(18, 4);
        ctx.lineTo(14, 27);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,190,190,.6)";
        ctx.beginPath();
        ctx.moveTo(-14, 0);
        ctx.lineTo(6, -12);
        ctx.lineTo(6, -3);
        ctx.closePath();
        ctx.fill();
        ctx.lineJoin = "miter";
    } else if (e.type === "green") {
        const leg = Math.sin(phase * 4) * 3;

        ctx.lineCap = "round";
        ctx.strokeStyle = "#0d3a14";
        ctx.lineWidth = 5;
        for (const [lx, ly, dir] of [[-15, 8, 1], [-5, 15, -1], [6, 15, 1], [16, 8, -1]]) {
            ctx.beginPath();
            ctx.moveTo(lx, ly);
            ctx.lineTo(lx + dir * 3, ly + 9 + leg * dir * .5);
            ctx.lineTo(lx + dir * 8, ly + 13 + leg * dir * .5);
            ctx.stroke();
        }
        ctx.lineCap = "butt";

        ctx.lineJoin = "round";
        ctx.lineWidth = 3.5;
        ctx.strokeStyle = "#0d3a14";

        ctx.fillStyle = "#8dff7a";
        ctx.beginPath();
        ctx.moveTo(0, -26);
        ctx.lineTo(22, -15);
        ctx.lineTo(0, -4);
        ctx.lineTo(-22, -15);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#48c443";
        ctx.beginPath();
        ctx.moveTo(-22, -15);
        ctx.lineTo(0, -4);
        ctx.lineTo(0, 20);
        ctx.lineTo(-22, 9);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#2c9433";
        ctx.beginPath();
        ctx.moveTo(0, -4);
        ctx.lineTo(22, -15);
        ctx.lineTo(22, 9);
        ctx.lineTo(0, 20);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#0a2a10";
        ctx.beginPath();
        ctx.moveTo(-17, -2);
        ctx.lineTo(-11, 1);
        ctx.lineTo(-11, 6);
        ctx.lineTo(-17, 3);
        ctx.closePath();
        ctx.moveTo(-8, 2);
        ctx.lineTo(-3, 4);
        ctx.lineTo(-3, 9);
        ctx.lineTo(-8, 7);
        ctx.closePath();
        ctx.fill();
        ctx.shadowColor = "#b8ff9a";
        ctx.shadowBlur = 8;
        ctx.fillStyle = "#c8ffae";
        ctx.fillRect(-15, 1, 2.5, 2.5);
        ctx.fillRect(-6, 5, 2.5, 2.5);
        ctx.shadowBlur = 0;
        ctx.lineJoin = "miter";
    } else if (e.type === "purple") {
        const arm = Math.sin(phase * 1.6) * 3;
        ctx.lineJoin = "round";
        ctx.lineWidth = 4;
        ctx.strokeStyle = "#2a0a45";

        ctx.fillStyle = "#5c1a99";
        ctx.fillRect(-22, 28, 15, 16);
        ctx.strokeRect(-22, 28, 15, 16);
        ctx.fillRect(7, 28, 15, 16);
        ctx.strokeRect(7, 28, 15, 16);

        ctx.fillStyle = "#7a28c4";
        for (const s of [-1, 1]) {
            ctx.beginPath();
            ctx.moveTo(s * 34, -14);
            ctx.lineTo(s * 54, -4 + arm * s);
            ctx.lineTo(s * 52, 24 + arm * s);
            ctx.lineTo(s * 32, 18);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
        }

        const hex = [
            [0, -54], [30, -38], [37, -2], [25, 32], [-25, 32], [-37, -2], [-30, -38]
        ];
        ctx.fillStyle = "#8a2fd6";
        ctx.beginPath();
        hex.forEach(([hx, hy], i) => i ? ctx.lineTo(hx, hy) : ctx.moveTo(hx, hy));
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#b45cff";
        ctx.beginPath();
        ctx.moveTo(0, -54);
        ctx.lineTo(-30, -38);
        ctx.lineTo(-37, -2);
        ctx.lineTo(-6, -10);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = "#6c22b3";
        ctx.beginPath();
        ctx.moveTo(-37, -2);
        ctx.lineTo(-6, -10);
        ctx.lineTo(6, -10);
        ctx.lineTo(37, -2);
        ctx.lineTo(25, 32);
        ctx.lineTo(-25, 32);
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = "#2a0a45";
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(0, -54);
        ctx.lineTo(-6, -10);
        ctx.moveTo(-6, -10);
        ctx.lineTo(-37, -2);
        ctx.moveTo(6, -10);
        ctx.lineTo(37, -2);
        ctx.moveTo(-6, -10);
        ctx.lineTo(6, -10);
        ctx.stroke();

        ctx.shadowColor = "#ff4be0";
        ctx.shadowBlur = 10;
        ctx.fillStyle = "#ff9af2";
        ctx.fillRect(-19, -28, 10, 6);
        ctx.fillRect(4, -28, 10, 6);
        ctx.shadowBlur = 0;
        ctx.lineJoin = "miter";
    } else if (e.type === "bat") {
        const flap = Math.sin(performance.now() * .02 + e.wobble);
        ctx.translate(0, -10);

        ctx.fillStyle = "#3b2a78";
        ctx.strokeStyle = "#0d0820";
        ctx.lineWidth = 3;
        for (const s of [-1, 1]) {
            ctx.beginPath();
            ctx.moveTo(s * 6, -4);
            ctx.quadraticCurveTo(s * 28, -22 - flap * 10, s * 40, -6 - flap * 12);
            ctx.quadraticCurveTo(s * 32, -2, s * 27, 7);
            ctx.quadraticCurveTo(s * 21, 0, s * 15, 9);
            ctx.quadraticCurveTo(s * 10, 3, s * 6, 9);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
        }

        ctx.fillStyle = "#5a44b8";
        ctx.beginPath();
        ctx.ellipse(0, 0, 10, 13, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#5a44b8";
        for (const s of [-1, 1]) {
            ctx.beginPath();
            ctx.moveTo(s * 3, -11);
            ctx.lineTo(s * 8, -22);
            ctx.lineTo(s * 9, -9);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
        }

        ctx.shadowColor = "#ffe14d";
        ctx.shadowBlur = 8;
        ctx.fillStyle = "#ffe14d";
        ctx.beginPath();
        ctx.arc(-4, -3, 2.6, 0, Math.PI * 2);
        ctx.arc(4, -3, 2.6, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.moveTo(-3.5, 5);
        ctx.lineTo(-2, 10);
        ctx.lineTo(-.5, 5);
        ctx.moveTo(.5, 5);
        ctx.lineTo(2, 10);
        ctx.lineTo(3.5, 5);
        ctx.fill();
    } else if (e.type === "beetle") {
        const legStep = Math.sin(phase * 4);

        ctx.strokeStyle = "#2b1d0b";
        ctx.lineWidth = 4;
        for (let i = 0; i < 3; i++) {
            const lx = -14 + i * 14;
            const swing = (i % 2 === 0 ? legStep : -legStep) * 5;
            for (const s of [-1, 1]) {
                ctx.beginPath();
                ctx.moveTo(lx, s * 12);
                ctx.lineTo(lx + swing, s * 26);
                ctx.lineTo(lx + swing * 1.4, s * 32);
                ctx.stroke();
            }
        }

        ctx.fillStyle = "#3a2a12";
        ctx.beginPath();
        ctx.ellipse(-31, 2, 12, 11, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.lineWidth = 3;
        for (const s of [-1, 1]) {
            ctx.beginPath();
            ctx.moveTo(-40, s * 5);
            ctx.lineTo(-48, s * 10);
            ctx.lineTo(-44, s * 2);
            ctx.stroke();
        }
        ctx.fillStyle = "#ff4545";
        ctx.beginPath();
        ctx.arc(-34, -3, 2.5, 0, Math.PI * 2);
        ctx.arc(-34, 7, 2.5, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#d99a2b";
        ctx.strokeStyle = "#2b1d0b";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.ellipse(6, 2, 32, 26, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.strokeStyle = "#7a4d0c";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(-24, 2);
        ctx.lineTo(38, 2);
        ctx.moveTo(4, -22);
        ctx.quadraticCurveTo(-4, 2, 4, 26);
        ctx.moveTo(20, -18);
        ctx.quadraticCurveTo(14, 2, 20, 22);
        ctx.stroke();

        ctx.fillStyle = "rgba(255,240,190,.45)";
        ctx.beginPath();
        ctx.ellipse(-2, -12, 12, 5, -.3, 0, Math.PI * 2);
        ctx.fill();
    } else if (e.type === "slime" || e.type === "minislime") {
        const k = e.type === "minislime" ? .6 : 1;
        const sq = Math.sin(phase * 2.2) * .09;
        ctx.scale(k * (1 + sq), k * (1 - sq));

        ctx.fillStyle = "#f2e13a";
        ctx.strokeStyle = "#8a7a00";
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.moveTo(-26, 18);
        ctx.bezierCurveTo(-32, -8, -14, -30, 0, -30);
        ctx.bezierCurveTo(14, -30, 32, -8, 26, 18);
        ctx.quadraticCurveTo(14, 23, 0, 19);
        ctx.quadraticCurveTo(-14, 23, -26, 18);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.55)";
        ctx.beginPath();
        ctx.ellipse(-11, -16, 7, 4, -.6, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#b8a800";
        ctx.beginPath();
        ctx.arc(8, 6, 4, 0, Math.PI * 2);
        ctx.arc(-9, 10, 3, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(-8, -3, 5, 0, Math.PI * 2);
        ctx.arc(8, -3, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#1c1c1c";
        ctx.beginPath();
        ctx.arc(-9, -2, 2.4, 0, Math.PI * 2);
        ctx.arc(7, -2, 2.4, 0, Math.PI * 2);
        ctx.fill();
    } else if (e.type === "boss") {
        ctx.shadowColor = "#ff286d";
        ctx.shadowBlur = 28;
        ctx.fillStyle = "#8f143c";
        ctx.strokeStyle = "#ff547e";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(-52, -64);
        ctx.lineTo(-84, -108);
        ctx.lineTo(-30, -88);
        ctx.lineTo(0, -116);
        ctx.lineTo(30, -88);
        ctx.lineTo(84, -108);
        ctx.lineTo(52, -64);
        ctx.lineTo(78, -20);
        ctx.lineTo(65, 36);
        ctx.lineTo(25, 70);
        ctx.lineTo(0, 59);
        ctx.lineTo(-25, 70);
        ctx.lineTo(-65, 36);
        ctx.lineTo(-78, -20);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        ctx.shadowBlur = 0;

        ctx.fillStyle = "#ffe99a";
        ctx.shadowColor = "#ffcf59";
        ctx.shadowBlur = 18;
        ctx.beginPath();
        ctx.ellipse(-30, -28, 10, 7, -.2, 0, Math.PI * 2);
        ctx.ellipse(30, -28, 10, 7, .2, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#ff315f";
        ctx.beginPath();
        ctx.arc(0, 15 + Math.sin(phase * 2) * 4, 20, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
    } else {
        ctx.fillStyle = "#ff4c4c";
        ctx.beginPath();
        ctx.arc(0, 0, e.radius, 0, Math.PI * 2);
        ctx.fill();
    }

    ctx.restore();

    if (e.hitFlash > 0) {
        ctx.save();
        ctx.globalAlpha = clamp(e.hitFlash / .12, 0, 1) * .8;
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 3;
        ctx.shadowColor = "#ffffff";
        ctx.shadowBlur = 16;
        ctx.beginPath();
        ctx.arc(p.x, p.y + bob - 8, e.radius + 4, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
    }

    drawHealthBar(
        p.x,
        p.y + bob - e.radius - (e.type === "boss" ? 30 : 25),
        Math.min(e.radius * 2.3, 240),
        e.hp,
        e.maxHp,
        ENEMY_BAR_COLORS[e.type] || "#ff4c4c"
    );

    if (e.type === "boss") {
        ctx.fillStyle = "#ff7898";
        ctx.font = "bold 14px Arial";
        ctx.textAlign = "center";
        ctx.fillText("JEFE", p.x, p.y + bob - e.radius - 43);
    }
}

function drawAlly(ally) {
    const p = isoToScreen(ally.x, ally.y);
    const phase = ally.animTime * 8;
    const bob = ally.type === "drone"
        ? Math.sin(phase * 1.8) * 5
        : ally.moving ? Math.abs(Math.sin(phase)) * 2 : Math.sin(phase) * .8;

    if (ally.type === "drone" && ally.repairTarget) {
        const target = isoToScreen(ally.repairTarget.x, ally.repairTarget.y);
        ctx.save();
        ctx.globalAlpha = .72;
        ctx.strokeStyle = "#6af5ff";
        ctx.shadowColor = "#55eeff";
        ctx.shadowBlur = 12;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y - bob);
        ctx.lineTo(target.x, target.y - 16);
        ctx.stroke();
        ctx.restore();
    }

    ctx.save();
    ctx.translate(p.x, p.y + bob);

    ctx.fillStyle = "rgba(0,0,0,.32)";
    ctx.beginPath();
    ctx.ellipse(0, 14, ally.type === "commander" ? 30 : ally.type === "guard" ? 13 : 20, ally.type === "guard" ? 5 : 8, 0, 0, Math.PI * 2);
    ctx.fill();

    if (ally.type === "drone") {
        ctx.rotate(phase * .2);
        ctx.shadowColor = "#53eaff";
        ctx.shadowBlur = 18;
        ctx.fillStyle = "#91f5ff";
        ctx.strokeStyle = "#176a7c";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(0, -20);
        ctx.lineTo(25, 0);
        ctx.lineTo(0, 20);
        ctx.lineTo(-25, 0);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = "#f2ffff";
        ctx.beginPath();
        ctx.arc(0, 0, 6, 0, Math.PI * 2);
        ctx.fill();
        for (const rotorX of [-31, 31]) {
            ctx.strokeStyle = "#8ff7ff";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(rotorX - 7, Math.sin(phase * 8) * 2);
            ctx.lineTo(rotorX + 7, -Math.sin(phase * 8) * 2);
            ctx.stroke();
        }
    } else if (ally.type === "guard") {
        /* Guardia enano: casco grande, torso corto, patitas cortas */
        const step = ally.moving ? Math.sin(phase) : 0;

        ctx.strokeStyle = "#10191e";
        ctx.lineWidth = 2.5;

        ctx.fillStyle = "#294955";
        ctx.fillRect(-12, -4, 5, 11);

        ctx.fillStyle = "#728b92";
        ctx.save();
        ctx.translate(-4, 7);
        ctx.rotate(step * .4);
        ctx.fillRect(-2.5, 0, 5, 6);
        ctx.restore();
        ctx.save();
        ctx.translate(4, 7);
        ctx.rotate(-step * .4);
        ctx.fillRect(-2.5, 0, 5, 6);
        ctx.restore();

        ctx.fillStyle = "#d8e7ec";
        ctx.fillRect(-8, -6, 16, 14);
        ctx.strokeRect(-8, -6, 16, 14);

        ctx.fillStyle = "#4adff2";
        ctx.fillRect(-3, -2, 6, 3);

        ctx.fillStyle = "#f3fbfc";
        ctx.beginPath();
        ctx.arc(0, -14, 11, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#4adff2";
        ctx.beginPath();
        ctx.ellipse(2, -13, 7, 4.5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(255,255,255,.75)";
        ctx.beginPath();
        ctx.ellipse(4, -15, 2.5, 1.4, -.4, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = "#273943";
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.moveTo(6, 0);
        ctx.lineTo(15, -3);
        ctx.stroke();
        ctx.fillStyle = "#4ce7f5";
        ctx.beginPath();
        ctx.arc(16, -3.5, 2.5, 0, Math.PI * 2);
        ctx.fill();
    } else {
        /* Comandante con jetpack */
        const flame = 6 + Math.abs(Math.sin(phase * 5)) * 7 + (ally.moving ? 5 : 0);

        for (const tx of [-27, -20]) {
            ctx.save();
            ctx.shadowColor = "#ff9a3c";
