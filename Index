function drawColony() {

    const p = isoToScreen(colony.x, colony.y);
    const line = "#0a1a33";
    const cy = p.y - 6;

    /* Sombra */
    ctx.fillStyle = "rgba(20,15,15,.45)";
    ctx.beginPath();
    ctx.ellipse(p.x, p.y + 34, 150, 58, 0, 0, Math.PI * 2);
    ctx.fill();

    /* Patas de apoyo */
    ctx.lineWidth = 3.5;
    ctx.strokeStyle = line;
    ctx.fillStyle = "#2a64b8";
    for (const lx of [-118, -76, 76, 118]) {
        const ly = cy + 46 * Math.sqrt(1 - Math.pow(lx / 125, 2)) + 8;
        ctx.beginPath();
        ctx.roundRect(p.x + lx - 9, ly, 18, 30, 5);
        ctx.fill();
        ctx.stroke();
    }

    /* Anillo metalico (cilindro) */
    ctx.fillStyle = "#245aa8";
    ctx.beginPath();
    ctx.ellipse(p.x, cy + 26, 125, 46, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillRect(p.x - 125, cy, 250, 26);
    ctx.strokeStyle = line;
    ctx.beginPath();
    ctx.ellipse(p.x, cy + 26, 125, 46, 0, 0, Math.PI);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(p.x - 125, cy);
    ctx.lineTo(p.x - 125, cy + 26);
    ctx.moveTo(p.x + 125, cy);
    ctx.lineTo(p.x + 125, cy + 26);
    ctx.stroke();

    const rim = ctx.createLinearGradient(p.x - 125, cy - 46, p.x + 125, cy + 46);
    rim.addColorStop(0, "#6aaaf5");
    rim.addColorStop(1, "#2f6fc9");
    ctx.fillStyle = rim;
    ctx.beginPath();
    ctx.ellipse(p.x, cy, 125, 46, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    /* Luces del anillo */
    for (const lx of [-72, -42, -12]) {
        const ly = cy + 46 * Math.sqrt(1 - Math.pow(lx / 125, 2)) + 13;
        ctx.fillStyle = "#4ff6ff";
        ctx.shadowColor = "#00f3ff";
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(p.x + lx, ly, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.lineWidth = 2;
        ctx.stroke();
    }

    /* Puerta luminosa */
    const dx = p.x + 92;
    const dy = cy + 46 * Math.sqrt(1 - Math.pow(92 / 125, 2)) - 12;
    ctx.fillStyle = "#c9ffff";
    ctx.shadowColor = "#55f2ff";
    ctx.shadowBlur = 16;
    ctx.beginPath();
    ctx.roundRect(dx - 11, dy, 22, 34, 4);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.lineWidth = 3;
    ctx.stroke();

    /* Cupula de cristal */
    const dome = ctx.createLinearGradient(p.x - 100, cy - 95, p.x + 90, cy + 20);
    dome.addColorStop(0, "#9fdcff");
    dome.addColorStop(.35, "#3f8cf0");
    dome.addColorStop(1, "#1a45a8");
    ctx.fillStyle = dome;
    ctx.beginPath();
    ctx.ellipse(p.x, cy, 100, 95, 0, Math.PI, Math.PI * 2);
    ctx.ellipse(p.x, cy, 100, 38, 0, 0, Math.PI);
    ctx.closePath();
    ctx.fill();
    ctx.lineWidth = 4;
    ctx.stroke();

    ctx.fillStyle = "rgba(255,255,255,.6)";
    ctx.beginPath();
    ctx.ellipse(p.x - 42, cy - 68, 24, 10, -.6, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.ellipse(p.x - 12, cy - 82, 8, 4, -.3, 0, Math.PI * 2);
    ctx.fill();

    drawHealthBar(
        p.x,
        p.y + 105,
