/* =========================================================
   ESTADO
========================================================= */

let credits = 0;
let lives = 3;
let wave = 0;

let waveTimer = 0;
let spawnTimer = 0;

let waveInProgress = false;
let currentWaveEnemies = 0;
let spawnedThisWave = 0;

let selectedBuild = null;
let selectedWeapon = "blaster";
let shopOpen = false;
let recruitmentOpen = false;
let gameOver = false;

let enemies = [];
let bullets = [];
let structures = [];
let particles = [];
let coins = [];
let allies = [];
let screenShake = 0;

let player;
let colony;

const keys = {};

const mouse = {
    x: 0,
    y: 0,
    worldX: 0,
    worldY: 0,
    inside: false
};

/* =========================================================
   CÁMARA
========================================================= */

const camera = {
    x: WORLD_W / 2,
    y: WORLD_H / 2
};

function getCameraZoom() {
    return 1;

    const worldWidth = 2 * Math.SQRT2 * MOON_RADIUS * ISO_X;
    const worldHeight = 2 * Math.SQRT2 * MOON_RADIUS * ISO_Y;
    const margin = 16;

    return Math.max(.1, Math.min(1, (W - margin) / worldWidth, (H - margin) / worldHeight));
}

function isoToScreen(x, y, z = 0) {
    return {
        x: W / 2 + (x - camera.x - (y - camera.y)) * ISO_X,
        y: H / 2 + ((x - camera.x) + (y - camera.y)) * ISO_Y - z * ISO_Y
    };
}

function screenToIso(sx, sy) {
    const a = (sx - W / 2) / ISO_X;
    const b = (sy - H / 2) / ISO_Y;

    return {
        x: camera.x + (a + b) / 2,
        y: camera.y + (b - a) / 2
    };
}

/* =========================================================
   UTILIDADES
========================================================= */

function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
}

function dist(a, b) {
    return Math.hypot(a.x - b.x, a.y - b.y);
}

function rand(min, max) {
    return Math.random() * (max - min) + min;
}

const soundPresets = {
    blaster: [{ start: 620, end: 170, duration: .11, type: "square", volume: .035 }],
    scatter: [
        { start: 300, end: 90, duration: .14, type: "sawtooth", volume: .035 },
        { start: 520, end: 160, duration: .1, type: "square", volume: .025, delay: .025 }
    ],
    rail: [
        { start: 1250, end: 110, duration: .3, type: "sine", volume: .035 },
        { start: 180, end: 55, duration: .25, type: "square", volume: .025, delay: .025 }
    ],
    plasma: [
        { start: 140, end: 520, duration: .22, type: "sawtooth", volume: .025 },
        { start: 90, end: 260, duration: .28, type: "sine", volume: .03, delay: .035 }
    ],
    step: [{ start: 105, end: 55, duration: .07, type: "triangle", volume: .018 }],
    domeHit: [
        { start: 150, end: 48, duration: .22, type: "triangle", volume: .05 },
        { start: 620, end: 170, duration: .28, type: "sine", volume: .025, delay: .025 }
    ],
    hit: [{ start: 240, end: 90, duration: .08, type: "triangle", volume: .04 }],
    kill: [
        { start: 420, end: 680, duration: .12, type: "triangle", volume: .035 },
        { start: 680, end: 900, duration: .14, type: "sine", volume: .025, delay: .07 }
    ],
    build: [{ start: 300, end: 620, duration: .16, type: "sine", volume: .035 }],
    wave: [
        { start: 440, end: 520, duration: .14, type: "triangle", volume: .03 },
        { start: 590, end: 720, duration: .18, type: "triangle", volume: .035, delay: .12 }
    ],
    boss: [
        { start: 110, end: 85, duration: .38, type: "sawtooth", volume: .035 },
        { start: 220, end: 440, duration: .32, type: "square", volume: .025, delay: .12 }
    ],
    gameOver: [
        { start: 360, end: 240, duration: .24, type: "triangle", volume: .04 },
        { start: 240, end: 110, duration: .42, type: "sine", volume: .04, delay: .2 }
    ],
    coin: [{ start: 760, end: 1180, duration: .09, type: "sine", volume: .025 }]
};

let audioContext;

function playSound(name) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    const preset = soundPresets[name];

    if (!AudioContextClass || !preset || settings.mute || settings.vol <= 0) return;

    try {
        audioContext = audioContext || new AudioContextClass();

        if (audioContext.state === "suspended") {
            audioContext.resume();
        }

        const now = audioContext.currentTime;

        for (const sound of preset) {
            const startTime = now + (sound.delay || 0);
            const oscillator = audioContext.createOscillator();
            const gain = audioContext.createGain();

            oscillator.type = sound.type;
            oscillator.frequency.setValueAtTime(sound.start, startTime);
            oscillator.frequency.exponentialRampToValueAtTime(
                sound.end,
                startTime + sound.duration
            );
            gain.gain.setValueAtTime(.0001, startTime);
            gain.gain.exponentialRampToValueAtTime(Math.max(.0002, sound.volume * settings.vol / 100), startTime + .012);
            gain.gain.exponentialRampToValueAtTime(.0001, startTime + sound.duration);

            oscillator.connect(gain);
            gain.connect(audioContext.destination);
            oscillator.start(startTime);
            oscillator.stop(startTime + sound.duration + .02);
        }
    } catch {
        audioContext = null;
    }
}

/* =========================================================
   POLÍGONOS / ISO
========================================================= */

function polygon(points, fill, stroke = "#050505", width = 2) {
    ctx.beginPath();

    points.forEach((p, i) => {
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
    });

    ctx.closePath();

    ctx.fillStyle = fill;
    ctx.fill();

    if (stroke) {
        ctx.strokeStyle = stroke;
        ctx.lineWidth = width;
        ctx.stroke();
    }
}

function isoBox(
    x, y, z,
    sx, sy, sz,
    topColor,
    sideColor,
    frontColor
) {
    const p = isoToScreen(x, y, z);

    const top = [
        { x: p.x, y: p.y },
        { x: p.x + sx * ISO_X, y: p.y + sx * ISO_Y },
        { x: p.x + (sx - sy) * ISO_X, y: p.y + (sx + sy) * ISO_Y },
        { x: p.x - sy * ISO_X, y: p.y + sy * ISO_Y }
    ];

    const bottom = top.map(q => ({
        x: q.x,
        y: q.y + sz * ISO_Y
    }));

    polygon(
        top,
        topColor,
        "#050505",
        2
    );

    polygon(
        [
            top[3],
            top[2],
            bottom[2],
            bottom[3]
        ],
        sideColor,
        "#050505",
        2
    );

    polygon(
        [
            top[1],
            top[2],
            bottom[2],
            bottom[1]
        ],
        frontColor,
        "#050505",
        2
    );
}

/* =========================================================
   ESTRELLAS
========================================================= */

const stars = [];

for (let i = 0; i < 220; i++) {
    stars.push({
        x: Math.random(),
        y: Math.random() * .78,
        r: rand(.4, 1.7),
        alpha: rand(.25, .95)
    });
}

/* =========================================================
   FONDO ESPACIAL
========================================================= */

let horizonY = 0;

function drawSpaceFit() {
    horizonY = 0;

    const sky = ctx.createLinearGradient(0, 0, 0, H);
    sky.addColorStop(0, "#03060f");
    sky.addColorStop(1, "#0a1430");
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, W, H);

    for (const star of stars) {
        ctx.globalAlpha = star.alpha;
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(star.x * W, star.y * H, star.r * Math.max(1, 1.1 / VS), 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.globalAlpha = 1;

    const R = H * 0.085;
    const cx = W * 0.93;
    const cy = H * 0.15;

    const glow = ctx.createRadialGradient(cx, cy, R * .8, cx, cy, R * 1.6);
    glow.addColorStop(0, "rgba(0,255,240,.35)");
    glow.addColorStop(1, "rgba(0,255,240,0)");
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(cx, cy, R * 1.6, 0, Math.PI * 2);
    ctx.fill();

    const body = ctx.createRadialGradient(cx - R * .3, cy - R * .4, R * .1, cx, cy, R);
    body.addColorStop(0, "#7dfff5");
    body.addColorStop(.55, "#17dcdc");
    body.addColorStop(1, "#0a8ea8");
    ctx.fillStyle = body;
    ctx.beginPath();
    ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.fill();
}

function drawSpace() {
    if (FIT) { drawSpaceFit(); return; }
    horizonY = Math.max(110, H * 0.24);

    const sky = ctx.createLinearGradient(0, 0, 0, horizonY + 40);
    sky.addColorStop(0, "#03060f");
    sky.addColorStop(1, "#0a1836");
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, W, H);

    for (const star of stars) {
        if (star.y * H > horizonY) continue;
        ctx.globalAlpha = star.alpha;
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(star.x * W, star.y * H, star.r, 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.globalAlpha = 1;

    /* Planeta cian */

    const R = Math.min(W * 0.17, horizonY * 0.98);
    const cx = W * 0.5;
    const cy = horizonY + R * 0.12;

    const glow = ctx.createRadialGradient(cx, cy, R * 0.85, cx, cy, R * 1.45);
    glow.addColorStop(0, "rgba(0,255,240,.38)");
    glow.addColorStop(1, "rgba(0,255,240,0)");
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(cx, cy, R * 1.45, 0, Math.PI * 2);
    ctx.fill();

    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.clip();

    const body = ctx.createRadialGradient(cx - R * .3, cy - R * .4, R * .1, cx, cy, R);
    body.addColorStop(0, "#7dfff5");
    body.addColorStop(.55, "#17dcdc");
    body.addColorStop(1, "#0a8ea8");
    ctx.fillStyle = body;
    ctx.fillRect(cx - R, cy - R, R * 2, R * 2);

    ctx.fillStyle = "rgba(8,120,150,.42)";
    const blobs = [
        [-.35, -.45, .34, .17, -.3],
        [.25, -.55, .4, .15, .2],
        [.05, -.15, .3, .12, -.1],
        [-.55, -.05, .2, .1, .5],
        [.5, -.2, .22, .12, -.4]
    ];
    for (const [bx, by, bw, bh, rot] of blobs) {
        ctx.beginPath();
        ctx.ellipse(cx + bx * R, cy + by * R, bw * R, bh * R, rot, 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.restore();

    ctx.strokeStyle = "rgba(190,255,255,.55)";
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(cx, cy, R, Math.PI * 1.05, Math.PI * 1.95);
    ctx.stroke();

    /* Cresta rocosa del horizonte */

    const ridge = [];
    const steps = 40;
    for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const x = t * W;
        const edge = Math.pow(Math.abs(t - .5) * 2, 2.2) * horizonY * .5;
        const bump = Math.abs(Math.sin(i * 1.9)) * 12 + Math.abs(Math.sin(i * .7 + 1)) * 14;
        ridge.push({ x, y: horizonY - 6 - bump - edge });
    }

    ctx.beginPath();
    ctx.moveTo(0, horizonY + 10);
    for (const q of ridge) ctx.lineTo(q.x, q.y);
    ctx.lineTo(W, horizonY + 10);
    ctx.closePath();
    ctx.fillStyle = "#544a47";
    ctx.fill();
    ctx.strokeStyle = "#1f1917";
    ctx.lineWidth = 3;
    ctx.stroke();

    ctx.strokeStyle = "rgba(140,200,205,.55)";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ridge.forEach((q, i) => {
        if (i === 0) ctx.moveTo(q.x, q.y + 2);
        else ctx.lineTo(q.x, q.y + 2);
    });
    ctx.stroke();
}

/* =========================================================
   LUNA CIRCULAR
========================================================= */

const rocks = [];
const cracks = [];

function generateTerrain() {
    for (let i = 0; i < 110; i++) {

        let x, y;

        do {
            x = rand(
                MOON_CENTER.x - MOON_RADIUS,
                MOON_CENTER.x + MOON_RADIUS
            );

            y = rand(
                MOON_CENTER.y - MOON_RADIUS,
                MOON_CENTER.y + MOON_RADIUS
            );
        } while (
            Math.hypot(
                x - MOON_CENTER.x,
                y - MOON_CENTER.y
            ) > MOON_RADIUS - 40
        );

        rocks.push({
            x,
            y,
            size: rand(5, 20),
            height: rand(3, 10)
        });
    }

    for (let i = 0; i < 50; i++) {

        let x, y;

        do {
            x = rand(
                MOON_CENTER.x - MOON_RADIUS,
                MOON_CENTER.x + MOON_RADIUS
            );

            y = rand(
                MOON_CENTER.y - MOON_RADIUS,
                MOON_CENTER.y + MOON_RADIUS
            );
        } while (
            Math.hypot(
                x - MOON_CENTER.x,
                y - MOON_CENTER.y
            ) > MOON_RADIUS - 50
        );

        cracks.push({
            x,
            y,
            length: rand(15, 60),
            angle: rand(0, Math.PI * 2)
        });
    }
}

function drawMoon() {

    const center = isoToScreen(
        MOON_CENTER.x,
        MOON_CENTER.y
    );
    const visualRadius = FIT ? Math.SQRT2 * MOON_RADIUS * ISO_X : Math.max(
        Math.hypot(W / 2, H * ISO_X / (2 * ISO_Y)),
        Math.SQRT2 * MOON_RADIUS * ISO_X
    );

    const zoom = getCameraZoom();
    const clipX = zoom < 1 ? W / 2 - W / (2 * zoom) : 0;
    const clipY = zoom < 1 ? H / 2 - H / (2 * zoom) : horizonY;
    const clipWidth = zoom < 1 ? W / zoom : W;
    const clipHeight = zoom < 1 ? H / zoom : H - horizonY;

    ctx.save();
    if (!FIT) {
        ctx.beginPath();
        ctx.rect(clipX, clipY, clipWidth, clipHeight);
        ctx.clip();
    }

    ctx.save();

    ctx.translate(center.x, center.y);
    ctx.scale(1, ISO_Y / ISO_X);

    const gradient = ctx.createRadialGradient(
        -220,
        -170,
        50,
        0,
        0,
        visualRadius
    );

    gradient.addColorStop(0, "#a89d95");
    gradient.addColorStop(.5, "#8f847d");
    gradient.addColorStop(.85, "#766c67");
    gradient.addColorStop(1, "#4d4541");

    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(0, 0, visualRadius, 0, Math.PI * 2);
    ctx.fill();

    if (FIT) {
        /* borde de la luna: aro oscuro + aro claro interior */
        ctx.lineWidth = 12;
        ctx.strokeStyle = "#2a2321";
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(0, 0, visualRadius - 16, 0, Math.PI * 2);
        ctx.lineWidth = 3;
        ctx.strokeStyle = "rgba(190,180,170,.35)";
        ctx.stroke();
    }

    ctx.restore();

    /* Parches oscuros del suelo */

    for (const crack of cracks) {
        const p = isoToScreen(crack.x, crack.y);
        const w = crack.length * .55;
        const h = w * .45;
        polygon([
            { x: p.x - w, y: p.y },
            { x: p.x, y: p.y - h },
            { x: p.x + w, y: p.y },
            { x: p.x, y: p.y + h }
        ], "rgba(58,48,50,.32)", null);
    }

    /* Rocas */

    for (const rock of rocks) {
        const p = isoToScreen(rock.x, rock.y);

        ctx.fillStyle = "#6a615c";
        ctx.beginPath();
        ctx.ellipse(p.x, p.y, rock.size, rock.size * .5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#2a2321";
        ctx.lineWidth = 2.5;
        ctx.stroke();

        ctx.fillStyle = "#8a807a";
        ctx.beginPath();
        ctx.ellipse(p.x - rock.size * .1, p.y - rock.height * .35, rock.size * .7, rock.size * .32, 0, 0, Math.PI * 2);
        ctx.fill();
    }

    ctx.restore();
}
