function drawWorldObjects() {

    const objects = [];

    objects.push({
        depth:
            colony.x +
            colony.y,

        draw:
            drawColony
    });

    objects.push({
        depth: RECRUITMENT_STATION.x + RECRUITMENT_STATION.y,
        draw: drawRecruitmentStation
    });

    objects.push({
        depth:
            RECRUITMENT_STATION.x +
            RECRUITMENT_STATION.y,

        draw:
            drawRecruitmentStation
    });

    for (const s of structures) {

        objects.push({
            depth:
                s.x +
                s.y,

            draw:
                () => drawStructure(s)
        });
    }

    for (const e of enemies) {

        objects.push({
            depth:
                e.x +
                e.y,

            draw:
                () => drawEnemy(e)
        });
    }

    for (const ally of allies) {
        objects.push({
            depth: ally.x + ally.y,
            draw: () => drawAlly(ally)
        });
    }

    for (const ally of allies) {
        objects.push({
            depth: ally.x + ally.y,
            draw: () => drawAlly(ally)
        });
    }

    objects.push({
        depth:
            player.x +
            player.y,

        draw:
            drawPlayer
    });

    objects.sort(
        (a, b) =>
            a.depth -
            b.depth
    );

    for (const object of objects) {
        object.draw();
    }
}

