========================================================= */

function startWave() {

    wave++;

    waveInProgress = true;

    spawnTimer = 0;

    spawnedThisWave = 0;

    currentWaveEnemies = wave % 5 === 0
        ? 1 + Math.floor(wave / 15)
        : Math.min(4 + wave * 2, 60);

    playSound(wave % 5 === 0 ? "boss" : "wave");
}

function updateWaves(dt) {

    if (!waveInProgress) {

        waveTimer += dt;

        if (
            waveTimer >= 5
        ) {
            startWave();
        }

        return;
    }

    spawnTimer -= dt;

    if (
        spawnedThisWave <
        currentWaveEnemies &&
        spawnTimer <= 0
    ) {

        spawnEnemy();

        spawnedThisWave++;

        spawnTimer =
            Math.max(
                .25,
                1.1 -
                wave * .025
            );
    }

    if (
        spawnedThisWave >=
        currentWaveEnemies &&
        enemies.length === 0
    ) {

        waveInProgress = false;

        waveTimer = 0;

        dropCoin(
            colony.x,
            colony.y,
            100 + wave * 20
        );
    }
}

function getWeaponById(id) {
    return SHOP_WEAPONS.find(item => item.id === id) || SHOP_WEAPONS[0];
}

function getSelectedWeapon() {
    return getWeaponById(selectedWeapon);
}

function buyOrSelectWeapon(id) {
    const weapon = getWeaponById(id);

    if (!weapon.unlocked) {
        if (credits < weapon.price) return;

        credits -= weapon.price;
        weapon.unlocked = true;
    }

    selectedWeapon = weapon.id;
    shopOpen = false;
}

