<script>
"use strict";

/* =========================================================
   CANVAS
========================================================= */

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let W = 0;
let H = 0;
let VS = 1;          /* escala del mundo (mapa completo en móvil) */
let US = 1;          /* escala de los menús (independiente del mundo) */
let FIT = false, ZMUL = 1, UIS = 1;
let WW = 0, WH = 0;  /* tamaño lógico del mundo */
let UW = 0, UH = 0;  /* tamaño lógico de los menús */
const FIT_W = 1900, FIT_H = 1000;  /* cabe toda la luna jugable */
let DPR = Math.min(window.devicePixelRatio || 1, 2);

function resize() {
    const cw = canvas.clientWidth || window.innerWidth;
    const ch = canvas.clientHeight || window.innerHeight;

    VS = (FIT ? Math.min(cw / FIT_W, ch / FIT_H) : 1) * ZMUL;
    US = UIS;

    W = WW = cw / VS;
    H = WH = ch / VS;
    UW = cw / US;
    UH = ch / US;

    canvas.width = Math.round(cw * DPR);
    canvas.height = Math.round(ch * DPR);

    ctx.setTransform(DPR * VS, 0, 0, DPR * VS, 0, 0);
}

/* Ejecuta algo (dibujo o toque de menús) con el tamaño lógico de los menús */
function withUI(fn) {
    const sw = W, sh = H;
    W = UW;
    H = UH;
    try { return fn(); } finally { W = sw; H = sh; }
}

window.addEventListener("resize", resize);
resize();

/* =========================================================
   MUNDO
========================================================= */

const WORLD_W = 1500;
const WORLD_H = 900;

const MOON_CENTER = {
    x: WORLD_W / 2,
    y: WORLD_H / 2
};

const MOON_RADIUS = 820;

const ISO_X = 0.82;
const ISO_Y = 0.42;

const BUILD_COST = {
