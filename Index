}

#gameOver p {
    margin: 15px 0 25px;
    font-size: 20px;
}

#restart {
    padding: 13px 30px;
    background: #101b22;
    border: 2px solid white;
    color: white;
    font-size: 18px;
    cursor: pointer;
}

#restart:hover {
    background: #24343e;
}

#stage{position:fixed;left:0;right:0;top:env(safe-area-inset-top,0px);bottom:env(safe-area-inset-bottom,0px)}
body{touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;overscroll-behavior:none;-webkit-tap-highlight-color:transparent}
#touchUI{position:fixed;inset:0;pointer-events:none;z-index:10;--k:1;--o:.7}
#touchUI>*{pointer-events:auto}
.stick{position:fixed;width:calc(130px*var(--k));height:calc(130px*var(--k));border-radius:50%;background:rgba(14,34,42,calc(var(--o)*.5));border:2px solid rgba(82,230,255,var(--o));touch-action:none;bottom:calc(env(safe-area-inset-bottom,0px) + 22px)}
.stick .knob{position:absolute;left:50%;top:50%;width:46%;height:46%;margin:-23% 0 0 -23%;border-radius:50%;background:rgba(82,230,255,var(--o));box-shadow:0 0 14px rgba(82,230,255,.5);pointer-events:none}
#stickL{left:calc(env(safe-area-inset-left,0px) + 22px)}
#stickR{right:calc(env(safe-area-inset-right,0px) + 22px);border-color:rgba(255,112,112,var(--o))}
#stickR .knob{background:rgba(255,112,112,var(--o));box-shadow:0 0 14px rgba(255,112,112,.5)}
.lefty #stickL{left:auto;right:calc(env(safe-area-inset-right,0px) + 22px)}
.lefty #stickR{right:auto;left:calc(env(safe-area-inset-left,0px) + 22px)}
#actions{position:fixed;display:flex;gap:10px;bottom:calc(env(safe-area-inset-bottom,0px) + 40px);right:calc(env(safe-area-inset-right,0px) + 30px + 130px*var(--k))}
.lefty #actions{right:auto;left:calc(env(safe-area-inset-left,0px) + 30px + 130px*var(--k))}
