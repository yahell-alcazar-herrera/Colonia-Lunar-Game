.gbtn{min-width:48px;height:48px;padding:0 14px;border-radius:24px;background:rgba(14,34,42,.92);border:2px solid #52e6ff;color:#fff;font:bold 15px Arial,sans-serif;touch-action:manipulation}
#btnGear{position:fixed;left:calc(env(safe-area-inset-left,0px) + 8px);top:50%;margin-top:-24px;width:48px;padding:0;font-size:24px}
#btnPlace{border-color:#7cff89}#btnCancel{border-color:#ff6a6a}
#settings{position:fixed;inset:0;z-index:30;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.7)}
