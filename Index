function roundRectPath(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
}

function drawPanel(x, y, width, height) {
    ctx.save();
    roundRectPath(x, y, width, height, 10);
    ctx.fillStyle = "rgba(28,62,72,.8)";
    ctx.fill();
    ctx.strokeStyle = "rgba(130,205,215,.6)";
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.restore();
}

function drawBuildIcon(id, cx, cy) {
    const line = "#161219";
    ctx.save();
    ctx.translate(cx, cy);
    ctx.lineJoin = "round";
    ctx.lineWidth = 1.8;
    ctx.strokeStyle = line;

    if (id === "wall") {
        polygon([{x:-14,y:5},{x:8,y:-8},{x:14,y:-4},{x:-8,y:9}], "#c6cbde", line, 1.8);
        polygon([{x:-8,y:9},{x:14,y:-4},{x:14,y:1},{x:-8,y:14}], "#7d84a4", line, 1.8);
    } else if (id === "turret") {
        polygon([{x:0,y:-13},{x:-11,y:7},{x:0,y:12}], "#f5c826", line, 1.8);
        polygon([{x:0,y:-13},{x:0,y:12},{x:11,y:7}], "#c99a0e", line, 1.8);
        ctx.strokeStyle = "#5b6472";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(2, -5);
        ctx.lineTo(14, -10);
        ctx.stroke();
    } else if (id === "shield") {
        const g = ctx.createRadialGradient(-3, -3, 2, 0, 0, 13);
        g.addColorStop(0, "#e8853a");
        g.addColorStop(1, "#a94a12");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(0, 0, 13, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.strokeStyle = "rgba(255,210,150,.6)";
        ctx.beginPath();
        ctx.arc(0, 0, 7, 0, Math.PI * 2);
        ctx.stroke();
    } else if (id === "drill") {
        polygon([{x:0,y:-11},{x:11,y:-6},{x:0,y:-1},{x:-11,y:-6}], "#8dff86", line, 1.8);
        polygon([{x:-11,y:-6},{x:0,y:-1},{x:0,y:12},{x:-11,y:7}], "#48c443", line, 1.8);
        polygon([{x:0,y:-1},{x:11,y:-6},{x:11,y:7},{x:0,y:12}], "#2c9433", line, 1.8);
        polygon([{x:11,y:0},{x:19,y:3},{x:11,y:7}], "#cdd5d8", line, 1.5);
    }
    ctx.restore();
}

function drawHUD() {
