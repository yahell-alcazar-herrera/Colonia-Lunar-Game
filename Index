/* =========================================================
   ESCUDOS
========================================================= */

function isShielded(x, y) {

    for (const s of structures) {

        if (s.type !== "shield")
            continue;

        if (
            Math.hypot(
                x - s.x,
                y - s.y
            ) < 115
        ) {
            return true;
        }
    }

    return false;
}

/* =========================================================
   DISPAROS
========================================================= */

/*
    NUEVO SISTEMA DE DISPARO:

    El proyectil guarda la dirección exacta calculada
    desde la posición del jugador hasta el punto del
    mundo correspondiente al cursor.

    Así el click determina directamente la trayectoria.
*/

function shootPlayer(targetX, targetY) {
    if (player.shootCooldown > 0) return;

    const weapon = getSelectedWeapon();
    const dx = targetX - player.x;
    const dy = targetY - player.y;
    const length = Math.hypot(dx, dy);

    if (length < 0.001) return;

    const makeShot = (angleOffset = 0) => {
        const dirX = Math.cos(Math.atan2(dy, dx) + angleOffset);
        const dirY = Math.sin(Math.atan2(dy, dx) + angleOffset);

        bullets.push({
            x: player.x,
            y: player.y,
            vx: dirX * weapon.speed,
            vy: dirY * weapon.speed,
            damage: weapon.damage,
            life: 2,
            playerShot: true,
            color: weapon.color
        });
    };

    if (weapon.pellets) {
        for (let i = 0; i < weapon.pellets; i++) {
            const spreadOffset = (i - (weapon.pellets - 1) / 2) * (weapon.spread || 0.18);
            makeShot(spreadOffset);
        }
    } else {
        makeShot();
    }

    player.shootCooldown = weapon.fireRate;
    player.recoil = 1;
    player.flash = .09;
    playSound(weapon.id);
    createExplosion(
        player.x + dx / length * 22,
        player.y + dy / length * 22,
        weapon.color,
        .35
    );
}

function shootTurret(turret, target) {

    const dx =
        target.x - turret.x;

    const dy =
        target.y - turret.y;

    const length =
        Math.hypot(dx, dy);

    if (!length)
        return;

    bullets.push({
        x: turret.x,
        y: turret.y,

        vx: dx / length * 360,
        vy: dy / length * 360,

        damage: 42,

        life: 2,

        turretShot: true
    });
}

function drawBullet(b) {

    const p = isoToScreen(
        b.x,
        b.y
    );

    /*
       Línea de dirección para que sea
       mucho más evidente hacia dónde viaja.
    */

    const angle =
        Math.atan2(
            b.vy,
            b.vx
        );

    ctx.save();

    ctx.translate(
        p.x,
        p.y
    );

    ctx.rotate(angle);

    ctx.fillStyle = b.color || (b.turretShot ? "#ff3030" : "#00f3ff");

    ctx.shadowColor =
        ctx.fillStyle;

    ctx.shadowBlur = 10;

    if (b.rocket) {
        ctx.beginPath();
        ctx.ellipse(0, 0, 13, 5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#fff1cd";
        ctx.fillRect(5, -2, 6, 4);
        ctx.fillStyle = "#ffdc8c";
        ctx.beginPath();
        ctx.moveTo(-11, 0);
        ctx.lineTo(-23, -5);
        ctx.lineTo(-19, 0);
        ctx.lineTo(-23, 5);
        ctx.closePath();
        ctx.fill();
    } else {
        ctx.beginPath();
        ctx.moveTo(9, 0);
        ctx.lineTo(-7, -4);
        ctx.lineTo(-7, 4);
        ctx.closePath();
        ctx.fill();
    }

    ctx.restore();

    ctx.shadowBlur = 0;
}

function damageEnemy(enemy, damage, impactX, impactY, color) {
    if (enemy.armor) damage *= enemy.armor;
    enemy.hp -= damage;
    enemy.hitFlash = .12;
    createExplosion(impactX, impactY, color, .55);

    if (enemy.hp > 0) return;

    playSound("kill");
    screenShake = Math.max(
        screenShake,
        enemy.type === "boss" ? .32 : .14
    );
    dropCoin(enemy.x, enemy.y, enemy.reward);
    if (enemy.type === "boss") {
        notify("¡Jefe derrotado!", "#ffd166", { sub: `+${enemy.reward} monedas`, life: 4 });
    }
    createExplosion(
        enemy.x,
        enemy.y,
        ENEMY_DEATH_COLORS[enemy.type] || "#ff4a4a",
        enemy.type === "boss" ? 4.5 : 2.1
    );

    const index = enemies.indexOf(enemy);
    if (index !== -1) enemies.splice(index, 1);

    if (enemy.type === "slime") spawnMiniSlimes(enemy.x, enemy.y);
}

/* =========================================================
   PARTÍCULAS
========================================================= */

function createExplosion(
    x,
    y,
    color,
    scale = 1
) {

    const ringLife = .3;
    particles.push({
        x,
        y,
        vx: 0,
        vy: 0,
        life: ringLife,
        maxLife: ringLife,
        maxRadius: 24 * scale,
        color,
        kind: "ring"
    });

    const flashLife = .08;
    particles.push({
        x,
        y,
        vx: 0,
        vy: 0,
        life: flashLife,
        maxLife: flashLife,
        radius: 10 * scale,
        color: "#ffffff",
        kind: "flash"
    });

    const count = Math.max(4, Math.round(12 * scale));

    for (let i = 0; i < count; i++) {
        const life = rand(.25, .55) * Math.sqrt(scale);
        const angle = rand(0, Math.PI * 2);
        const speed = rand(65, 175) * scale;

        particles.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life,
            maxLife: life,
            size: rand(1.5, 3.2) * Math.sqrt(scale),
            gravity: 110,
            color,
            kind: "spark"
        });
    }
}

function updateParticles(dt) {

    for (
        let i = particles.length - 1;
        i >= 0;
        i--
    ) {

        const p = particles[i];

        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vy += (p.gravity || 0) * dt;

        p.life -= dt;

        if (p.life <= 0) {
            particles.splice(i, 1);
        }
    }
}

function drawParticles() {

    for (const p of particles) {

        const s =
            isoToScreen(
                p.x,
                p.y
            );

        const fade = clamp(p.life / p.maxLife, 0, 1);
        const progress = 1 - fade;

        ctx.globalAlpha = fade;
        ctx.strokeStyle = p.color;
        ctx.fillStyle = p.color;

        if (p.kind === "ring") {
            ctx.lineWidth = 3 * fade;
            ctx.beginPath();
            ctx.ellipse(
                s.x,
                s.y,
                Math.max(1, p.maxRadius * progress),
                Math.max(1, p.maxRadius * progress * .55),
                0,
                0,
                Math.PI * 2
            );
            ctx.stroke();
        } else if (p.kind === "flash") {
            ctx.globalAlpha = fade * .8;
            ctx.beginPath();
            ctx.arc(s.x, s.y, p.radius * fade, 0, Math.PI * 2);
            ctx.fill();
        } else {
            const tail = isoToScreen(
                p.x - p.vx * .035,
                p.y - p.vy * .035
            );
            ctx.lineWidth = Math.max(.6, p.size * fade);
            ctx.lineCap = "round";
            ctx.beginPath();
            ctx.moveTo(tail.x, tail.y);
            ctx.lineTo(s.x, s.y);
            ctx.stroke();
        }
    }

    ctx.globalAlpha = 1;
}

function dropCoin(x, y, value) {
    coins.push({
        x,
        y,
        previousX: x,
        previousY: y,
        vx: rand(-110, 110),
        vy: rand(-140, 40),
        value,
        age: 0,
        phase: rand(0, Math.PI * 2)
    });
}

function updateCoins(dt) {
    for (let i = coins.length - 1; i >= 0; i--) {
        const coin = coins[i];
        coin.previousX = coin.x;
        coin.previousY = coin.y;
        coin.age += dt;

        if (coin.age > .18) {
            const dx = player.x - coin.x;
            const dy = player.y - coin.y;
            const distance = Math.hypot(dx, dy) || 1;

            if (distance < player.radius + 14) {
                credits += coin.value;
                playSound("coin");
                createExplosion(player.x, player.y, "#ffd166", .35);
                coins.splice(i, 1);
                continue;
            }

            const speed = Math.min(850, 240 + distance * 2.2);
            const blend = 1 - Math.exp(-10 * dt);
            coin.vx += (dx / distance * speed - coin.vx) * blend;
            coin.vy += (dy / distance * speed - coin.vy) * blend;
        } else {
            const drag = Math.exp(-4 * dt);
            coin.vx *= drag;
            coin.vy = coin.vy * drag + 180 * dt;
        }

        coin.x += coin.vx * dt;
        coin.y += coin.vy * dt;
    }
}

function drawCoins() {
    const time = performance.now() * .01;

    for (const coin of coins) {
        const point = isoToScreen(coin.x, coin.y);
        const bob = Math.sin(time + coin.phase) * 2.5;

        if (coin.age > .18) {
            const previous = isoToScreen(coin.previousX, coin.previousY);
            ctx.globalAlpha = .28;
            ctx.strokeStyle = "#ffd166";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(previous.x, previous.y - 10);
            ctx.lineTo(point.x, point.y - 10 + bob);
            ctx.stroke();
        }

        ctx.save();
        ctx.translate(point.x, point.y - 12 + bob);
        ctx.shadowColor = "#ffbf32";
        ctx.shadowBlur = 16;
        ctx.fillStyle = "#ffc83d";
        ctx.beginPath();
        ctx.ellipse(0, 0, 7, 9, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = "#fff1a6";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(0, 0, 3, 6, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
    }

    ctx.globalAlpha = 1;
}

/* =========================================================
   JUGADOR / MOVIMIENTO
========================================================= */

function updatePlayer(dt) {
    const startX = player.x;
    const startY = player.y;
    player.animTime += dt;

    let dx = 0;
    let dy = 0;

    if (
        keys["w"] ||
        keys["W"] ||
        keys["ArrowUp"]
    ) dy -= 1;

    if (
        keys["s"] ||
        keys["S"] ||
        keys["ArrowDown"]
    ) dy += 1;

    if (
        keys["a"] ||
        keys["A"] ||
        keys["ArrowLeft"]
    ) dx -= 1;

    if (
        keys["d"] ||
        keys["D"] ||
        keys["ArrowRight"]
    ) dx += 1;

    if (touch.mx || touch.my) { dx = touch.mx; dy = touch.my; }

    if (dx || dy) {

        const length =
            Math.hypot(dx, dy);

        dx /= length;
        dy /= length;

        let nx =
            player.x +
            dx * player.speed * dt;

        let ny =
            player.y +
            dy * player.speed * dt;

        /*
           Mantener al jugador dentro
           de la luna circular.
        */

        const distance =
            Math.hypot(
                nx - MOON_CENTER.x,
                ny - MOON_CENTER.y
            );

        if (
            distance >
            MOON_RADIUS - 55
        ) {

            const angle =
                Math.atan2(
                    ny - MOON_CENTER.y,
                    nx - MOON_CENTER.x
                );

            nx =
                MOON_CENTER.x +
                Math.cos(angle) *
                (MOON_RADIUS - 55);

            ny =
                MOON_CENTER.y +
                Math.sin(angle) *
                (MOON_RADIUS - 55);
        }

        player.x = nx;
        player.y = ny;

        /*
           Colisiones con construcciones.
        */

        for (const s of structures) {

            const dx2 =
                player.x - s.x;

            const dy2 =
                player.y - s.y;

            const d =
                Math.hypot(
                    dx2,
                    dy2
                );

            const minimum =
                player.radius + 35;

            if (d < minimum) {

                const angle =
                    Math.atan2(
                        dy2,
                        dx2
                    );

                player.x =
                    s.x +
                    Math.cos(angle) *
                    minimum;

                player.y =
                    s.y +
                    Math.sin(angle) *
                    minimum;
            }
        }
    }

    player.moving = Math.hypot(player.x - startX, player.y - startY) > .1;

    if (player.moving) {
        player.stepTimer -= dt;

        if (player.stepTimer <= 0) {
            playSound("step");
            player.stepTimer = .38;
        }
    } else {
        player.stepTimer = 0;
    }

    player.shootCooldown -= dt;
    player.recoil = Math.max(0, (player.recoil || 0) - dt * 8);
    player.flash = Math.max(0, (player.flash || 0) - dt);
}

/* =========================================================
   ENEMIGOS
========================================================= */

function updateEnemies(dt) {

    for (
        let i = enemies.length - 1;
        i >= 0;
        i--
    ) {

        const e = enemies[i];

        e.attackCooldown -= dt;
        e.hitFlash = Math.max(0, (e.hitFlash || 0) - dt);

        const playerDistance =
            Math.hypot(
                player.x - e.x,
                player.y - e.y
            );

        /*
           Atacar jugador si está muy cerca.
        */

        if (playerDistance < 100) {

            if (e.attackCooldown <= 0) {

                player.hp -= e.damage;

                createExplosion(
                    player.x,
                    player.y,
                    "#ff5555",
                    1.3
                );
                screenShake = Math.max(screenShake, .12);

                e.attackCooldown = 1;
            }

            continue;
        }

        let allyTarget = null;
        let allyDistance = 82;

        for (const ally of allies) {
            const distance = Math.hypot(ally.x - e.x, ally.y - e.y);
            if (distance < allyDistance) {
                allyTarget = ally;
                allyDistance = distance;
            }
        }

        if (allyTarget) {
            if (e.attackCooldown <= 0) {
                allyTarget.hp -= e.damage;
                createExplosion(
                    allyTarget.x,
                    allyTarget.y,
                    allyTarget.type === "drone" ? "#65eaff" : "#ff6969",
                    .8
                );
                playSound("hit");
                screenShake = Math.max(screenShake, .06);

                if (allyTarget.hp <= 0) {
                    createExplosion(
                        allyTarget.x,
                        allyTarget.y,
                        allyTarget.type === "drone" ? "#65eaff" : "#ff6969",
                        1.5
                    );
                    allies.splice(allies.indexOf(allyTarget), 1);
                }

                e.attackCooldown = 1;
            }

            continue;
        }

        /*
           Buscar estructura.
        */

        let target = null;
        let targetDistance = Infinity;

        for (const s of structures) {

            const d =
                Math.hypot(
                    s.x - e.x,
                    s.y - e.y
                );

            if (
                d < targetDistance
            ) {
                targetDistance = d;
                target = s;
            }
        }

        /*
           Atacar construcción cercana.
        */

        if (
            target &&
            targetDistance < 85
        ) {

            if (
                e.attackCooldown <= 0
            ) {

                if (
                    !isShielded(
                        target.x,
                        target.y
                    )
                ) {
                    target.hp -= e.damage;
                    createExplosion(target.x, target.y, "#ffad5c", .45);
                    screenShake = Math.max(screenShake, .04);
                }

                e.attackCooldown = 1;
            }

            continue;
        }

        /*
           Ir hacia la colonia.
        */

        const dx =
            colony.x - e.x;

        const dy =
            colony.y - e.y;

        const d =
            Math.hypot(
                dx,
                dy
            ) || 1;

        let moveX = dx / d;
        let moveY = dy / d;

        if (e.type === "bat") {
            const sway = Math.sin(performance.now() * .006 + e.wobble) * .9;
            moveX += -moveY * sway;
            moveY += (dx / d) * sway;
            const moveLength = Math.hypot(moveX, moveY) || 1;
            moveX /= moveLength;
            moveY /= moveLength;
        }

        e.x +=
            moveX *
            e.speed *
            dt;

        e.y +=
            moveY *
            e.speed *
            dt;

        const colonyDistance =
            Math.hypot(
                colony.x - e.x,
                colony.y - e.y
            );

        if (
            colonyDistance <
            colony.radius
        ) {

            if (
                e.attackCooldown <= 0
            ) {

                if (
                    !isShielded(
                        colony.x,
                        colony.y
                    )
                ) {
                    colony.hp -=
                        e.damage;
                    playSound("domeHit");
                    createExplosion(
                        colony.x + rand(-22, 22),
                        colony.y + rand(-14, 14),
                        "#56edff",
                        1.2
                    );
                    screenShake = Math.max(screenShake, .18);
                }

                e.attackCooldown = 1;
            }
        }
    }
}

/* =========================================================
   BALAS
========================================================= */

function updateBullets(dt) {

    for (
        let i = bullets.length - 1;
        i >= 0;
        i--
    ) {

        const b = bullets[i];

        b.x +=
            b.vx * dt;

        b.y +=
            b.vy * dt;

        b.life -= dt;

        if (Math.random() < dt * 22) {
            const trailLife = .13;
            particles.push({
                x: b.x,
                y: b.y,
                vx: -b.vx * .035 + rand(-14, 14),
                vy: -b.vy * .035 + rand(-14, 14),
                life: trailLife,
                maxLife: trailLife,
                size: b.turretShot ? 2.4 : 1.8,
                gravity: 0,
                color: b.color || (b.turretShot ? "#ff3030" : "#00f3ff"),
                kind: "spark"
            });
        }

        let hit = false;

        for (
            let j = enemies.length - 1;
            j >= 0;
            j--
        ) {

            const e = enemies[j];

            if (Math.hypot(b.x - e.x, b.y - e.y) >= e.radius + 8) continue;

            hit = true;
            playSound("hit");

            if (b.aoeRadius) {
                screenShake = Math.max(screenShake, .12);
                createExplosion(b.x, b.y, b.color || "#ff9d52", 1.8);

                for (let k = enemies.length - 1; k >= 0; k--) {
                    const target = enemies[k];
                    if (Math.hypot(target.x - b.x, target.y - b.y) <= b.aoeRadius) {
                        damageEnemy(target, b.damage, target.x, target.y, b.color || "#ff9d52");
                    }
                }
            } else {
                damageEnemy(e, b.damage, b.x, b.y, b.color || "#ffffff");
            }

            break;
        }

        if (
            hit ||
            b.life <= 0
        ) {
            bullets.splice(
                i,
                1
            );
        }
    }
}

/* =========================================================
   TORRETAS
========================================================= */

function updateTurrets(dt) {

    for (const s of structures) {

        if (
            s.type !== "turret"
        ) continue;

        s.cooldown -= dt;

        if (
            s.cooldown <= 0
        ) {

            let target = null;
            let shortest = 500;

            for (const e of enemies) {

                const d =
                    Math.hypot(
                        e.x - s.x,
                        e.y - s.y
                    );

                if (
                    d < shortest
                ) {
                    shortest = d;
                    target = e;
                }
            }

            if (target) {

                shootTurret(
                    s,
                    target
                );

                s.cooldown = .8;
            }
        }
    }
}

function findNearestEnemy(x, y, range) {
    let nearest = null;
    let nearestDistance = range;

    for (const enemy of enemies) {
        const distance = Math.hypot(enemy.x - x, enemy.y - y);
        if (distance < nearestDistance) {
            nearest = enemy;
            nearestDistance = distance;
        }
    }

    return { enemy: nearest, distance: nearestDistance };
}

function moveAllyToward(ally, x, y, dt) {
    const dx = x - ally.x;
    const dy = y - ally.y;
    const distance = Math.hypot(dx, dy);

    if (distance < 2) {
        ally.moving = false;
        return;
    }

    const step = Math.min(distance, ally.speed * dt);
    ally.x += dx / distance * step;
    ally.y += dy / distance * step;
    ally.moving = true;
}

function fireAllyWeapon(ally, target, rocket = false) {
    const dx = target.x - ally.x;
    const dy = target.y - ally.y;
    const distance = Math.hypot(dx, dy) || 1;

    bullets.push({
        x: ally.x,
        y: ally.y,
        vx: dx / distance * (rocket ? 360 : 560),
        vy: dy / distance * (rocket ? 360 : 560),
        damage: ally.damage,
        life: rocket ? 2.8 : 2,
        allyShot: true,
        rocket,
        aoeRadius: rocket ? 125 : 0,
        color: rocket ? "#ff9d52" : "#8affc1"
    });

    if (rocket) {
        playSound("rail");
    } else {
        playSound("blaster");
    }
}

function updateAllies(dt) {
    for (const ally of allies) {
        ally.animTime += dt;
        ally.fireCooldown -= dt;
        ally.repairClock -= dt;
        ally.repairTarget = null;

        if (ally.type === "drone") {
            let target = null;
            let targetDistance = Infinity;

            for (const structure of structures) {
                if (
                    (structure.type !== "wall" && structure.type !== "turret") ||
                    structure.hp >= structure.maxHp
                ) continue;

                const distance = Math.hypot(structure.x - ally.x, structure.y - ally.y);
                if (distance < targetDistance) {
                    target = structure;
                    targetDistance = distance;
                }
            }

            if (target) {
                ally.repairTarget = target;
                moveAllyToward(ally, target.x, target.y, dt);

                if (targetDistance < 48) {
                    ally.moving = false;
                    target.hp = Math.min(target.maxHp, target.hp + 32 * dt);
                    if (ally.repairClock <= 0) {
                        createExplosion(target.x, target.y, "#61efff", .3);
                        ally.repairClock = .45;
                    }
                }
            } else {
                ally.patrolAngle += dt * .45;
                const idleX = RECRUITMENT_STATION.x + Math.cos(ally.patrolAngle) * 48;
                const idleY = RECRUITMENT_STATION.y + Math.sin(ally.patrolAngle) * 34;
                moveAllyToward(ally, idleX, idleY, dt);
            }

            continue;
        }

        const commander = ally.type === "commander";
        const patrolTarget = {
            x: colony.x + Math.cos(ally.patrolAngle + ally.animTime * .28) * ally.patrolRadius,
            y: colony.y + Math.sin(ally.patrolAngle + ally.animTime * .28) * ally.patrolRadius
        };
        const { enemy, distance } = findNearestEnemy(ally.x, ally.y, commander ? 720 : 560);

        if (!enemy) {
            if (!commander) {
                moveAllyToward(ally, patrolTarget.x, patrolTarget.y, dt);
            } else {
                ally.moving = false;
            }
            continue;
        }

        const preferredRange = commander ? 470 : 330;
        if (distance > preferredRange) {
            const dx = enemy.x - ally.x;
            const dy = enemy.y - ally.y;
            const length = Math.hypot(dx, dy) || 1;
            moveAllyToward(
                ally,
                enemy.x - dx / length * preferredRange,
                enemy.y - dy / length * preferredRange,
                dt
            );
        } else {
            ally.moving = false;
        }

        if (distance <= (commander ? 620 : 470) && ally.fireCooldown <= 0) {
            fireAllyWeapon(ally, enemy, commander);
            ally.fireCooldown = commander ? 2.4 : .9;
        }
    }
}

