let notifications = [];
let notifiedUnlocks = new Set();
let notifyState = { wave: 0, inProgress: false, colonyLow: false };

const NEW_ENEMY_WAVES = {
    2: ["Murciélagos", "Rápidos y en zigzag"],
    3: ["Limos tóxicos", "Se dividen en dos al morir"],
    4: ["Escarabajos blindados", "Resisten el 40% del daño"]
};

function resetNotifications() {
    notifications = [];
    notifiedUnlocks = new Set();
    notifyState = { wave: 0, inProgress: false, colonyLow: false };
}

function notify(text, color, opts) {
    opts = opts || {};
    const life = opts.life || 5;
    const existing = notifications.find(n => n.text === text && !!n.big === !!opts.big);
    if (existing) {
        existing.life = life;
        existing.maxLife = life;
        return;
    }

    notifications.push({
        text,
        sub: opts.sub || "",
        color: color || "#7cf5ff",
        big: !!opts.big,
        life,
        maxLife: life
    });

    const normal = notifications.filter(n => !n.big);
    if (normal.length > 4) {
        notifications.splice(notifications.indexOf(normal[0]), 1);
    }
}

function checkUnlockNotifications() {
    for (const w of SHOP_WEAPONS) {
        if (w.unlocked || w.price <= 0) continue;
        const key = "weapon:" + w.id;
        if (notifiedUnlocks.has(key) || credits < w.price) continue;
        notifiedUnlocks.add(key);
        notify(
            "¡Ya puedes mejorar tu arma!",
            w.color,
            { sub: `${w.name} · ${w.price}$ — abre la TIENDA` }
        );
    }

    for (const [hotkey, type] of Object.entries(BUILD_KEYS)) {
        const key = "build:" + type;
        if (notifiedUnlocks.has(key) || credits < BUILD_COST[type]) continue;
        notifiedUnlocks.add(key);
        const item = BUILD_MENU_ITEMS.find(i => i.id === type);
        notify(
            `¡Ya puedes construir: ${item ? item.name : type}!`,
            "#7cff89",
            { sub: `${BUILD_COST[type]}$ · presiona la tecla ${hotkey}` }
        );
    }

    for (const recruit of ALLY_RECRUITS) {
        const key = "ally:" + recruit.id;
        if (notifiedUnlocks.has(key) || credits < recruit.price) continue;
        notifiedUnlocks.add(key);
        notify(
            "¡Ya puedes reclutar un ayudante!",
            "#8cecff",
            { sub: `${recruit.name} · ${recruit.price}$ — ve a la estación de reclutamiento` }
        );
    }
}

function updateNotifications(dt) {
    if (wave !== notifyState.wave) {
        notifyState.wave = wave;

        if (wave > 0) {
            if (wave % 5 === 0) {
                const bosses = 1 + Math.floor(wave / 15);
                notify(
                    bosses > 1 ? "¡JEFES APROXIMÁNDOSE!" : "¡JEFE APROXIMÁNDOSE!",
                    "#ff4f7d",
                    { big: true, sub: `Oleada ${wave}`, life: 4 }
                );
            } else {
                notify(
                    `Oleada ${wave}`,
                    "#52e6ff",
                    {
                        sub: wave % 5 === 4
                            ? "¡El jefe llega en la siguiente oleada!"
                            : `${currentWaveEnemies} enemigos`,
                        life: 4
                    }
                );
            }

            const fresh = NEW_ENEMY_WAVES[wave];
            if (fresh) {
                notify(`Nuevo enemigo: ${fresh[0]}`, "#ffb02e", { sub: fresh[1] });
            }
        }
    }

    if (notifyState.inProgress && !waveInProgress && wave > 0) {
        notify(
            `¡Oleada ${wave} completada!`,
            "#7cff89",
            { sub: `Bonus +${100 + wave * 20} monedas` }
        );
    }
    notifyState.inProgress = waveInProgress;

    if (colony) {
        const ratio = colony.hp / colony.maxHp;
        if (ratio < .3 && !notifyState.colonyLow) {
            notifyState.colonyLow = true;
            notify("¡La cúpula está en peligro!", "#ff6a6a", { sub: "Defiéndela antes de que caiga" });
        } else if (ratio > .5) {
            notifyState.colonyLow = false;
        }
    }

    checkUnlockNotifications();

    for (let i = notifications.length - 1; i >= 0; i--) {
        notifications[i].life -= dt;
        if (notifications[i].life <= 0) notifications.splice(i, 1);
    }
}

function drawNotifications() {
    if (!notifications.length) return;

    ctx.save();
    ctx.textAlign = "left";

    let y = 22;

    for (const n of notifications) {
        if (n.big) continue;

        const age = n.maxLife - n.life;
        const inT = clamp(age / .25, 0, 1);
        const outT = clamp(n.life / .4, 0, 1);

        ctx.font = "bold 15px Arial";
        const tw = ctx.measureText(n.text).width;
        let sw = 0;
        if (n.sub) {
            ctx.font = "12px Arial";
            sw = ctx.measureText(n.sub).width;
        }

        const w = Math.max(tw, sw) + 64;
        const h = n.sub ? 50 : 36;
        const x = W / 2 - w / 2;
        const yy = y - (1 - inT) * 16;

        ctx.globalAlpha = Math.min(inT, outT);

        roundRectPath(x, yy, w, h, 10);
        ctx.fillStyle = "rgba(14,34,42,.93)";
        ctx.fill();
        ctx.strokeStyle = n.color;
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = n.color;
        ctx.beginPath();
        ctx.arc(x + 24, yy + h / 2, 9, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#0a1a22";
        ctx.font = "bold 13px Arial";
        ctx.textAlign = "center";
        ctx.fillText("!", x + 24, yy + h / 2 + 4.5);
        ctx.textAlign = "left";

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 15px Arial";
        ctx.fillText(n.text, x + 44, yy + (n.sub ? 21 : 23));
        if (n.sub) {
            ctx.fillStyle = "#b9d4da";
            ctx.font = "12px Arial";
            ctx.fillText(n.sub, x + 44, yy + 39);
        }

        y += h + 8;
    }

    for (const n of notifications) {
        if (!n.big) continue;

        const age = n.maxLife - n.life;
        const inT = clamp(age / .35, 0, 1);
        const outT = clamp(n.life / .6, 0, 1);
        const alpha = Math.min(inT, outT);
        const pulse = .5 + .5 * Math.sin(performance.now() * .012);
        const scale = 1 + (1 - inT) * .45;
        const cy = H * .24;

        ctx.globalAlpha = alpha;

        const band = ctx.createLinearGradient(0, 0, W, 0);
        band.addColorStop(0, "rgba(90,0,25,0)");
        band.addColorStop(.25, "rgba(90,0,25,.55)");
        band.addColorStop(.75, "rgba(90,0,25,.55)");
        band.addColorStop(1, "rgba(90,0,25,0)");
        ctx.fillStyle = band;
        ctx.fillRect(0, cy - 52, W, 104);

        ctx.textAlign = "center";
        ctx.save();
        ctx.translate(W / 2, cy);
        ctx.scale(scale, scale);
        ctx.shadowColor = n.color;
        ctx.shadowBlur = 10 + 18 * pulse;
        ctx.fillStyle = n.color;
        ctx.font = "bold 44px Arial";
        ctx.fillText(n.text, 0, 8);
        ctx.shadowBlur = 0;
        if (n.sub) {
            ctx.fillStyle = "#ffd6e0";
            ctx.font = "bold 18px Arial";
            ctx.fillText(n.sub, 0, 38);
        }
        ctx.restore();
    }

    ctx.globalAlpha = 1;
    ctx.restore();
}

function update(dt) {

    if (window.__paused) return;

    screenShake = Math.max(0, screenShake - dt * 1.8);

    if (gameOver)
        return;

    updatePlayer(dt);
    updateWaves(dt);
    updateNotifications(dt);
    updateEnemies(dt);
    updateAllies(dt);
    updateBullets(dt);
    updateCoins(dt);
    updateTurrets(dt);
    updateDrills(dt);
    updateParticles(dt);
    touchUpdate(dt);

    cleanupStructures();

    checkGameOver();
}

