const I18N_KEYS = Object.keys(I18N).sort((a, b) => b.length - a.length);
let trCache = {};

function tr(s) {
    s = String(s);
    const li = ["en", "pt", "fr"].indexOf(settings.lang);
    if (li < 0 || !/[A-Za-zÀ-ÿ¡]/.test(s)) return s;

    const ck = li + s;
    if (trCache[ck] !== undefined) return trCache[ck];

    let out = null;
    if (I18N[s]) out = I18N[s][li];

    if (out === null) {
        const nums = s.match(/\d+/g) || [];
        const tpl = s.replace(/\d+/g, "#");
        if (nums.length && I18N[tpl]) {
            let i = 0;
            out = I18N[tpl][li].replace(/#/g, () => nums[i++] ?? "");
        }
    }

    if (out === null) {
        out = s;
        for (const k of I18N_KEYS) {
            if (out.includes(k)) out = out.split(k).join(I18N[k][li]);
        }
    }

    if (Object.keys(trCache).length > 3000) trCache = {};
    return (trCache[ck] = out);
}

/* Traduce todo el texto que el juego dibuja en el canvas */
const _fillText = CanvasRenderingContext2D.prototype.fillText.bind(ctx);
const _measureText = CanvasRenderingContext2D.prototype.measureText.bind(ctx);
ctx.fillText = (t, x, y, mw) => _fillText(tr(t), x, y, mw);
ctx.measureText = t => _measureText(tr(t));

function applyLang() {
    document.documentElement.lang = settings.lang;
    document.querySelectorAll("[data-i18n]").forEach(el => { el.textContent = tr(el.dataset.i18n); });
    document.getElementById("btnGear").setAttribute("aria-label", tr("Ajustes"));
}

/* ---------- Panel de ajustes ---------- */

const PANEL = [
    ["h", "Sonido"],
    ["range", "vol", "Volumen", 0, 200, 10],
    ["check", "mute", "Silenciar"],
    ["h", "Gráficos"],
    ["select", "res", "Resolución", [[1, "Baja"], [1.5, "Media"], [2, "Alta"]]],
    ["select", "particles", "Partículas", [[0, "Pocas"], [1, "Medias"], [2, "Muchas"]]],
    ["check", "glow", "Brillos y sombras"],
    ["range", "shake", "Temblor de pantalla", 0, 1, 0.25],
    ["check", "fit", "Ver mapa completo"],
    ["range", "zoom", "Zoom", 0.7, 1.4, 0.05],
    ["range", "ui", "Tamaño de menús", 0.4, 1, 0.05],
    ["h", "Controles"],
    ["check", "touch", "Controles táctiles"],
    ["check", "autoaim", "Auto-apuntar"],
    ["check", "lefty", "Modo zurdo"],
    ["range", "size", "Tamaño de controles", 70, 140, 10],
    ["range", "opacity", "Opacidad de controles", 30, 100, 10],
    ["h", "Idioma"],
    ["select", "lang", "Idioma", Object.entries(LANGS)]
];

function buildPanel() {
    const box = document.getElementById("panel");
    box.innerHTML = "";

    for (const [type, key, label, a, b, c] of PANEL) {
        if (type === "h") {
            const h = document.createElement("h3");
            h.textContent = tr(key);
            box.appendChild(h);
            continue;
        }

        const row = document.createElement("label");
        row.className = "row";
        const name = document.createElement("span");
        name.textContent = tr(label);
        row.appendChild(name);

        let input;
        if (type === "select") {
            input = document.createElement("select");
            for (const [v, t] of (a)) {
                const o = document.createElement("option");
                o.value = v;
                o.textContent = key === "lang" ? t : tr(t);
                input.appendChild(o);
            }
            input.value = settings[key];
        } else if (type === "range") {
            input = document.createElement("input");
            input.type = "range";
            input.min = a; input.max = b; input.step = c;
            input.value = settings[key];
        } else {
            input = document.createElement("input");
            input.type = "checkbox";
            input.checked = !!settings[key];
        }

        input.addEventListener("input", () => {
            settings[key] = type === "check" ? input.checked : (isNaN(+input.value) ? input.value : +input.value);
            applyUI(key === "lang");
        });
        row.appendChild(input);
        box.appendChild(row);
    }
}

function applyUI(rebuild) {
    try { localStorage.setItem("colonia-settings-v4", JSON.stringify(settings)); } catch { }

    const ui = document.getElementById("touchUI");
    ui.style.setProperty("--k", settings.size / 100);
    ui.style.setProperty("--o", settings.opacity / 100);
    ui.classList.toggle("lefty", settings.lefty);
    document.getElementById("stickL").style.display = settings.touch ? "" : "none";
    document.getElementById("stickR").style.display = settings.touch ? "" : "none";

    FIT = !!settings.fit;
    ZMUL = settings.zoom || 1;
    UIS = settings.ui || 1;
    DPR = Math.min(window.devicePixelRatio || 1, settings.res);
    resize();

    if (settings.glow) delete ctx.shadowBlur;
    else { try { Object.defineProperty(ctx, "shadowBlur", { set() { }, get() { return 0; }, configurable: true }); } catch { } }

    if (rebuild) { trCache = {}; buildPanel(); }
    applyLang();
}

function setSettingsOpen(open) {
    document.getElementById("settings").style.display = open ? "flex" : "none";
    window.__paused = open;
    if (open) buildPanel();
}

document.getElementById("btnGear").addEventListener("click", () => setSettingsOpen(true));
