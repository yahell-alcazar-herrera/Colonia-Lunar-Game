   DRAW
========================================================= */

function draw() {

    ctx.save();

    if (screenShake > 0) {
        const shake = screenShake * 22 * settings.shake;
        ctx.translate(rand(-shake, shake), rand(-shake, shake));
    }

    drawSpace();

    const zoom = getCameraZoom();
    ctx.translate(W / 2, H / 2);
    ctx.scale(zoom, zoom);
    ctx.translate(-W / 2, -H / 2);

    drawMoon();

    drawWorldObjects();
    drawCoins();

    for (const b of bullets) {
        drawBullet(b);
    }

    drawParticles();

    drawBuildPreview();

    ctx.restore();

    ctx.save();
    ctx.setTransform(DPR * US, 0, 0, DPR * US, 0, 0);
    withUI(() => {
        drawShop();
        drawRecruitmentMenu();
        drawHUD();
        drawNotifications();
    });
    ctx.restore();
    syncTouchUI();
}

